# publish/.env 로 복사해서 값을 채우세요. 이 파일은 git 에 올라가지 않습니다.
# 하나도 없어도 --preview 와 네이버 초안은 됩니다.

# ── 텔레그램 : 가장 쉬움. @BotFather 에서 봇 만들고 토큰 복사 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 메타(스레드·인스타·페이스북) : developers.facebook.com 앱 ──
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
IG_USER_ID=
META_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ── 유튜브 : console.cloud.google.com → YouTube Data API v3 ──
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=public

# ── X : developer.x.com (글쓰기는 유료 플랜) ──
X_ACCESS_TOKEN=

# ── 링크드인 : developer.linkedin.com (w_member_social 승인) ──
LI_ACCESS_TOKEN=
LI_PERSON_URN=

# ── 틱톡 : developers.tiktok.com (심사 필요) ──
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# ── 무료·심사없음 : 여기부터 채우세요 (다 합쳐 10분) ──
BSKY_HANDLE=
BSKY_APP_PASSWORD=
DISCORD_WEBHOOK_URL=
MASTODON_HOST=https://mastodon.social
MASTODON_ACCESS_TOKEN=
