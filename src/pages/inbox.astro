---
import Base from '../layouts/Base.astro';
import { geneMap } from '../data/dna.js';

// 승격 파이프라인 — 던진 것이 자산이 될 때까지 한 칸씩 올라가는 화면.
// "기록이 아니라 승격이 핵심이다." (아람) · "세컨브레인의 어려운 부분은 수집이 아니라 출구다." (딜런)
const stages = [
  { id: 'inbox',  ko: '인박스', ic: '📥', desc: '던져진 그대로. 아직 아무 판단도 안 했다.', from: '띵크 · 린디 · 곽동욱' },
  { id: 'sorted', ko: '정리됨', ic: '🗂', desc: '무엇인지 정해졌다. 종류·태그·기한이 붙었다.', from: '세계로 · 치코 · 지니' },
  { id: 'wiki',   ko: '지식',   ic: '🧠', desc: '다른 것과 엮였다. 다시 꺼내 쓸 수 있다.', from: '흐민 · 레미 · 그린' },
  { id: 'asset',  ko: '자산',   ic: '💎', desc: '밖으로 나갈 수 있다. 글·부품·결정이 됐다.', from: '잭 · 하니 · 제인' },
];
const g = (id) => geneMap[id];
---

<Base title="인박스 — 승격 파이프라인">
  <section class="ib-head">
    <div class="wrap">
      <p class="section-kicker" data-reveal>The Promotion Pipeline</p>
      <h1 data-reveal="60">던진 게 <mark>자산이 될 때까지</mark></h1>
      <p class="lead" data-reveal="120">
        메모앱은 쌓기만 한다. 여기는 <b>한 칸씩 올린다</b> — 인박스 → 정리됨 → 지식 → 자산.
        오른쪽 아래 <b>⚡ 버튼</b>(또는 아무 페이지에서 <kbd>C</kbd>)으로 던지면 알아서 분류돼 여기 들어온다.
      </p>

      <div class="ib-stats" id="ibStats" data-reveal="160"></div>

      <div class="ib-bar">
        <div class="ib-fl" role="group" aria-label="종류">
          <button class="ibf on" data-k="all" type="button">전체</button>
          <button class="ibf" data-k="thought" type="button">💭 생각</button>
          <button class="ibf" data-k="todo" type="button">✅ 할 일</button>
          <button class="ibf" data-k="event" type="button">📅 일정</button>
          <button class="ibf" data-k="ref" type="button">🔗 자료</button>
          <button class="ibf" data-k="question" type="button">❓ 질문</button>
          <button class="ibf" data-k="decision" type="button">⚖️ 결정</button>
        </div>
        <div class="ib-fl" role="group" aria-label="근거">
          <button class="ibf" data-v="unknown" type="button">○ 미확인만</button>
        </div>
        <div class="ib-right">
          <input id="ibQ" type="search" placeholder="내가 던진 것 검색" autocomplete="off" />
          <button class="ibf" id="ibSeed" type="button" title="예시 5개 넣기">예시 넣기</button>
          <button class="ibf" id="ibExport" type="button">내보내기</button>
        </div>
      </div>
    </div>
  </section>

  <section class="ib-pipe">
    <div class="wrap">
      <div class="pipe-grid" id="pipeGrid">
        {stages.map((s, i) => (
          <div class="pipe-col" data-stage={s.id}>
            <div class="pipe-top">
              <span class="pipe-ic">{s.ic}</span>
              <span class="pipe-ko">{s.ko}</span>
              <span class="pipe-n" data-n={s.id}>0</span>
            </div>
            <p class="pipe-desc">{s.desc}</p>
            <p class="pipe-from">← {s.from}</p>
            <div class="pipe-list" data-list={s.id}></div>
            <p class="pipe-empty" data-empty={s.id}>{i === 0 ? '아직 던진 게 없어요. ⚡ 를 눌러보세요.' : '여기로 올라온 게 아직 없어요.'}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 결정 카드 : 답을 주지 않고 결론에 닿게 한다 (르니 · 위버 · 설록 · 콩) -->
  <section class="ib-dec">
    <div class="wrap">
      <p class="section-kicker" data-reveal>Decision Cards</p>
      <h2 data-reveal="60">결정은 <mark>카드로 남는다</mark></h2>
      <p class="lead" data-reveal="120">
        고민을 던지면 <b>결정 · 기준 · 리스크 · 첫걸음</b> 네 칸으로 닫는다.
        쌓인 결정은 다음 결정의 재료가 된다 — 챗창 혼자서는 못 만드는 부분이 바로 이 누적이다. <span class="from">← 르니 · 콩 · 미미</span>
      </p>

      <form class="dec-form" id="decForm">
        <input id="decQ" placeholder="무엇을 정해야 하나요? (예: 아라미러를 서버로 올릴까 로컬로 둘까)" required />
        <div class="dec-4">
          <label>📌 결정<textarea id="decD" rows="2" placeholder="무엇으로 정했나"></textarea></label>
          <label>🎯 기준<textarea id="decC" rows="2" placeholder="왜 그렇게 정했나 — 판단 기준"></textarea></label>
          <label>⚠️ 리스크<textarea id="decR" rows="2" placeholder="이 선택이 틀렸다면 무엇 때문일까"></textarea></label>
          <label>👣 첫걸음<textarea id="decF" rows="2" placeholder="내일 당장 할 한 가지"></textarea></label>
        </div>
        <button type="submit" class="dec-save">결정 카드 남기기</button>
      </form>

      <div class="dec-list" id="decList"></div>
    </div>
  </section>

  <!-- 정직 : 안 쓰는 기능이 드러나야 한다 (웃는돌 · 마크 · 최강훈) -->
  <section class="ib-honest">
    <div class="wrap">
      <p class="section-kicker" data-reveal>Honest Log</p>
      <h2 data-reveal="60">내가 <mark>진짜로 여는 곳</mark></h2>
      <p class="lead" data-reveal="120">
        "만들어서 배포까지 다 했는데, 정작 내가 안 쓰게 됐다." — 웃는돌.
        기능을 더 붙이기 전에 <b>안 쓰는 게 뭔지</b>부터 드러낸다. 이 기록은 이 브라우저에만 남는다.
      </p>
      <div class="honest-grid" id="honestGrid"></div>
    </div>
  </section>

  <style is:global>
    .ib-head { padding: 96px 0 0; }
    .ib-head h1 { font-size: clamp(2.1rem, 5.4vw, 3.4rem); letter-spacing: -.045em; font-weight: 800; line-height: 1.06; margin: 0 0 16px; }
    .ib-head kbd { font-family: var(--mono); font-size: .78em; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; padding: 1px 6px; background: var(--bg-2); }
    .ib-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(112px, 1fr)); gap: 10px; margin: 26px 0 22px; }
    .ib-st { border: 1px solid var(--line); border-radius: 14px; padding: 15px 16px; background: var(--bg-1); }
    .ib-st b { display: block; font-family: var(--mono); font-size: 1.7rem; font-weight: 700; letter-spacing: -.03em; color: var(--accent); }
    .ib-st span { display: block; font-size: .78rem; color: var(--muted); margin-top: 2px; }
    .ib-st.good b { color: #3c8f6b; }

    .ib-bar { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 14px 0 0; border-top: 1px solid var(--line-soft); }
    .ib-fl { display: flex; gap: 5px; flex-wrap: wrap; }
    .ibf { font-family: inherit; font-size: .82rem; font-weight: 600; cursor: pointer; padding: 6px 13px; border-radius: 999px;
      border: 1px solid var(--line); background: var(--bg-1); color: var(--muted); transition: .18s var(--ease); white-space: nowrap; }
    .ibf:hover { color: var(--fg); border-color: var(--accent); }
    .ibf.on { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    .ib-right { margin-left: auto; display: flex; gap: 7px; align-items: center; flex-wrap: wrap; min-width: 0; }
    .ib-right input { font-family: inherit; font-size: .86rem; padding: 7px 15px; width: min(230px, 46vw);
      border-radius: 999px; border: 1px solid var(--line); background: var(--bg-1); color: var(--fg); }
    .ib-right input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }

    .ib-pipe { padding: 30px 0 90px; border-top: 0; }
    .pipe-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; align-items: start; }
    .pipe-col { background: var(--bg-2); border: 1px solid var(--line); border-radius: 18px; padding: 16px 14px; min-height: 220px; }
    .pipe-col[data-stage="asset"] { background: linear-gradient(180deg, rgba(52,211,192,.10), var(--bg-2)); border-color: rgba(52,211,192,.36); }
    .pipe-top { display: flex; align-items: center; gap: 8px; }
    .pipe-ic { font-size: 1.1rem; }
    .pipe-ko { font-weight: 800; letter-spacing: -.02em; }
    .pipe-n { margin-left: auto; font-family: var(--mono); font-weight: 700; color: var(--accent); font-size: 1.05rem; }
    .pipe-desc { margin: 8px 0 2px; font-size: .8rem; color: var(--muted); line-height: 1.5; }
    .pipe-from { margin: 0 0 12px; font-size: .7rem; color: var(--faint); }
    .pipe-list { display: flex; flex-direction: column; gap: 8px; }
    .pipe-empty { font-size: .8rem; color: var(--faint); text-align: center; padding: 22px 6px; line-height: 1.6; }

    .ic { position: relative; background: var(--bg-1); border: 1px solid var(--line); border-radius: 13px; padding: 11px 12px 10px;
      border-left: 3px solid var(--kc, var(--accent)); animation: icIn .35s var(--ease) both; }
    @keyframes icIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .ic-top { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
    .ic-kind { font-size: .68rem; font-weight: 700; color: var(--kc); }
    .ic-due { font-size: .66rem; font-family: var(--mono); color: var(--muted); }
    .ic-due.over { color: #d94b3a; font-weight: 700; }
    .ic-v { margin-left: auto; font-size: .7rem; cursor: pointer; background: none; border: 0; padding: 2px 4px; font-family: inherit; }
    .ic-txt { font-size: .88rem; line-height: 1.55; color: var(--fg); word-break: break-word; }
    .ic-txt.done { text-decoration: line-through; color: var(--muted); }
    .ic-why { margin: 6px 0 0; font-size: .68rem; color: var(--faint); line-height: 1.45; }
    .ic-tags { margin-top: 6px; display: flex; gap: 4px; flex-wrap: wrap; }
    .ic-tag { font-size: .64rem; background: var(--accent-soft); color: var(--accent-strong); border-radius: 5px; padding: 1px 6px; }
    .ic-act { display: flex; gap: 4px; margin-top: 9px; align-items: center; }
    .ic-b { font-family: inherit; font-size: .68rem; font-weight: 700; cursor: pointer; border: 1px solid var(--line);
      background: var(--bg-2); color: var(--fg-soft); border-radius: 7px; padding: 4px 8px; transition: .16s var(--ease); }
    .ic-b:hover { border-color: var(--accent); color: var(--accent-strong); background: var(--accent-soft); }
    .ic-b.up { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    .ic-b.up:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
    .ic-b.del { margin-left: auto; color: var(--faint); }
    .ic-b.del:hover { color: #d94b3a; border-color: #d94b3a; background: rgba(217,75,58,.08); }

    .ib-dec { padding: 90px 0; background: var(--bg-soft); border-top: 1px solid var(--line-soft); }
    .ib-dec .from, .ib-honest .from { color: var(--muted); font-size: .9em; }
    .dec-form { margin-top: 26px; background: var(--bg-1); border: 1px solid var(--line); border-radius: 20px; padding: 22px 24px; }
    .dec-form > input { width: 100%; font-family: inherit; font-size: 1rem; font-weight: 600; padding: 12px 14px;
      border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); color: var(--fg); }
    .dec-form > input:focus, .dec-form textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .dec-4 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }
    .dec-4 label { display: block; font-size: .8rem; font-weight: 700; color: var(--fg-soft); }
    .dec-4 textarea { width: 100%; margin-top: 5px; font-family: inherit; font-size: .9rem; line-height: 1.55; resize: vertical;
      border: 1px solid var(--line); border-radius: 11px; padding: 9px 11px; background: var(--bg-2); color: var(--fg); }
    .dec-save { margin-top: 14px; font-family: inherit; font-weight: 700; font-size: .92rem; cursor: pointer; border: 0;
      border-radius: 999px; padding: 11px 26px; background: var(--grad); color: #fff; box-shadow: 0 10px 24px var(--accent-glow); }
    .dec-list { margin-top: 22px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
    .dc { background: var(--bg-1); border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px; }
    .dc h4 { margin: 0 0 12px; font-size: 1.02rem; letter-spacing: -.02em; }
    .dc dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 6px 10px; }
    .dc dt { font-size: .72rem; font-weight: 700; color: var(--accent); white-space: nowrap; }
    .dc dd { margin: 0; font-size: .87rem; color: var(--fg-soft); line-height: 1.55; }
    .dc-bot { display: flex; align-items: center; gap: 10px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line-soft); }
    .dc-ts { font-family: var(--mono); font-size: .68rem; color: var(--faint); }
    .dc-del { margin-left: auto; font-family: inherit; font-size: .7rem; cursor: pointer; background: none; border: 0; color: var(--faint); }
    .dc-del:hover { color: #d94b3a; }
    .dec-none { color: var(--muted); font-size: .92rem; padding: 26px 0; }

    .ib-honest { padding: 90px 0; border-top: 1px solid var(--line-soft); }
    .honest-grid { margin-top: 26px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
    .hs { border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; background: var(--bg-1); }
    .hs.cold { border-style: dashed; opacity: .82; }
    .hs-p { font-family: var(--mono); font-size: .84rem; font-weight: 600; color: var(--fg); }
    .hs-n { font-size: .76rem; color: var(--muted); margin-top: 3px; }
    .hs-n b { color: var(--accent); font-family: var(--mono); }

    @media (max-width: 900px) { .pipe-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 680px) {
      .pipe-grid { grid-template-columns: 1fr; }
      .dec-4 { grid-template-columns: 1fr; }
      .ib-right { margin-left: 0; width: 100%; }
      .ib-right input { flex: 1 1 100%; width: auto; min-width: 0; }
      .ib-bar { gap: 8px 10px; }
    }
  </style>

  <script>
    import * as OS from '../lib/os-core.js';
    import * as GM from '../lib/game.js';

    const $ = (s) => document.querySelector(s);
    const $$ = (s) => Array.prototype.slice.call(document.querySelectorAll(s));
    const KIND = Object.fromEntries(OS.KINDS.map((k) => [k.id, k]));
    const VER = Object.fromEntries(OS.VERIFY.map((v) => [v.id, v]));
    const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    let f = { kind: 'all', verified: null, q: '' };

    /* ── 통계 ── */
    function renderStats() {
      const s = OS.stats();
      $('#ibStats').innerHTML = [
        ['총 던진 것', s.total, ''],
        ['오늘', s.today, ''],
        ['연속', s.streak + '일', ''],
        ['안 끝난 할 일', s.openTodo, ''],
        ['미확인 근거', s.unverified, ''],
        ['자산까지', s.assets, 'good'],
        ['승격률', s.promoteRate + '%', 'good'],
        ['결정 카드', s.decisions, ''],
      ].map(([l, v, c]) => `<div class="ib-st ${c}"><b>${esc(v)}</b><span>${esc(l)}</span></div>`).join('');
    }

    /* ── 파이프라인 ── */
    function card(i) {
      const k = KIND[i.kind] || { ic: '·', ko: i.kind, c: '#999' };
      const v = VER[i.verified] || VER.unknown;
      const today = OS.todayStr();
      const over = i.due && i.due < today && !i.done;
      const at = OS.STAGE_IDS.indexOf(i.stage);
      return `<div class="ic" style="--kc:${k.c}" id="${i.id}">
        <div class="ic-top">
          <span class="ic-kind">${k.ic} ${esc(k.ko)}</span>
          ${i.due ? `<span class="ic-due ${over ? 'over' : ''}">📅 ${esc(i.due)}${over ? ' 지남' : ''}</span>` : ''}
          <button class="ic-v" data-v="${i.id}" title="${esc(v.desc)} — 눌러서 바꾸기" style="color:${v.c}">${v.ic} ${esc(v.ko)}</button>
        </div>
        <div class="ic-txt ${i.done ? 'done' : ''}">${esc(i.text)}</div>
        ${i.routeWhy ? `<p class="ic-why">🎼 ${esc(i.routeWhy)}</p>` : ''}
        ${(i.tags || []).length ? `<div class="ic-tags">${i.tags.map((t) => `<span class="ic-tag">#${esc(t)}</span>`).join('')}</div>` : ''}
        <div class="ic-act">
          ${at > 0 ? `<button class="ic-b" data-dn="${i.id}" title="한 칸 내리기">←</button>` : ''}
          ${at < 3 ? `<button class="ic-b up" data-up="${i.id}">승격 →</button>` : '<span class="ic-tag">💎 자산</span>'}
          ${i.kind === 'todo' ? `<button class="ic-b" data-done="${i.id}">${i.done ? '되돌리기' : '완료'}</button>` : ''}
          ${i.kind === 'question' || i.kind === 'decision' ? `<button class="ic-b" data-dec="${i.id}">결정카드</button>` : ''}
          <button class="ic-b del" data-del="${i.id}">삭제</button>
        </div>
      </div>`;
    }
    function renderPipe() {
      const all = OS.getItems({ q: f.q, verified: f.verified || undefined });
      const items = f.kind === 'all' ? all : all.filter((i) => i.kind === f.kind);
      OS.STAGE_IDS.forEach((sid) => {
        const list = items.filter((i) => i.stage === sid);
        const el = document.querySelector(`[data-list="${sid}"]`);
        const em = document.querySelector(`[data-empty="${sid}"]`);
        const n = document.querySelector(`[data-n="${sid}"]`);
        if (n) n.textContent = String(list.length);
        if (el) el.innerHTML = list.map(card).join('');
        if (em) em.hidden = list.length > 0;
      });
    }

    /* ── 결정 카드 ── */
    function renderDecisions() {
      const ds = OS.getDecisions();
      const el = $('#decList');
      if (!ds.length) { el.innerHTML = '<p class="dec-none">아직 남긴 결정이 없어요. 위에서 한 장 남겨보세요 — 쌓이면 다음 결정이 쉬워집니다.</p>'; return; }
      el.innerHTML = ds.map((d) => `<article class="dc">
        <h4>${esc(d.q)}</h4>
        <dl>
          ${d.decision ? `<dt>📌 결정</dt><dd>${esc(d.decision)}</dd>` : ''}
          ${d.criteria ? `<dt>🎯 기준</dt><dd>${esc(d.criteria)}</dd>` : ''}
          ${d.risk ? `<dt>⚠️ 리스크</dt><dd>${esc(d.risk)}</dd>` : ''}
          ${d.firstStep ? `<dt>👣 첫걸음</dt><dd>${esc(d.firstStep)}</dd>` : ''}
        </dl>
        <div class="dc-bot"><span class="dc-ts">${new Date(d.ts).toLocaleString('ko-KR')}</span>
        <button class="dc-del" data-dd="${d.id}">삭제</button></div>
      </article>`).join('');
    }

    /* ── 정직 로그 ── */
    function renderHonest() {
      const u = OS.getUsage();
      const rows = Object.entries(u).sort((a, b) => b[1].n - a[1].n).slice(0, 12);
      const el = $('#honestGrid');
      if (!rows.length) { el.innerHTML = '<p class="dec-none">아직 기록이 없어요. 페이지를 열 때마다 여기 쌓입니다.</p>'; return; }
      const cut = Date.now() - 14 * 864e5;
      el.innerHTML = rows.map(([p, r]) => {
        const cold = r.last < cut;
        const days = Math.max(0, Math.round((Date.now() - r.last) / 864e5));
        return `<div class="hs ${cold ? 'cold' : ''}">
          <div class="hs-p">${esc(p)}</div>
          <div class="hs-n"><b>${r.n}</b>번 열었고, ${days === 0 ? '오늘' : days + '일 전'}이 마지막${cold ? ' — 2주 넘게 안 열었어요' : ''}</div>
        </div>`;
      }).join('');
    }

    function renderAll() { renderStats(); renderPipe(); renderDecisions(); renderHonest(); }

    /* ── 이벤트 (그리드는 매번 다시 그리므로 위임) ── */
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      const up = t.dataset.up, dn = t.dataset.dn, del = t.dataset.del, dv = t.dataset.v,
            done = t.dataset.done, dec = t.dataset.dec, dd = t.dataset.dd;
      if (up) { OS.promote(up, 1); GM.bump('up'); renderAll(); }
      else if (dn) { OS.promote(dn, -1); renderAll(); }
      else if (del) { OS.removeItem(del); GM.bump('deleted'); renderAll(); }
      else if (done) { OS.toggleDone(done); renderAll(); }
      else if (dv) {
        const cur = OS.getItem(dv);
        const order = ['unknown', 'verified', 'inferred'];
        OS.setVerified(dv, order[(order.indexOf(cur.verified) + 1) % 3]);
        renderAll();
      } else if (dec) {
        const it = OS.getItem(dec);
        if (it) {
          document.querySelector('#decQ').value = it.text;
          document.querySelector('.ib-dec').scrollIntoView({ behavior: 'smooth' });
          document.querySelector('#decD').focus();
        }
      } else if (dd) { OS.removeDecision(dd); renderAll(); }
    });

    $$('.ibf[data-k]').forEach((b) => b.addEventListener('click', () => {
      f.kind = b.dataset.k;
      $$('.ibf[data-k]').forEach((x) => x.classList.toggle('on', x === b));
      renderPipe();
    }));
    $$('.ibf[data-v]').forEach((b) => b.addEventListener('click', () => {
      f.verified = f.verified ? null : b.dataset.v;
      b.classList.toggle('on', !!f.verified);
      renderPipe();
    }));
    $('#ibQ')?.addEventListener('input', (e) => { f.q = e.target.value.trim(); renderPipe(); });
    $('#ibSeed')?.addEventListener('click', () => { OS.seedIfEmpty(); renderAll(); });
    $('#ibExport')?.addEventListener('click', () => {
      const b = new Blob([OS.exportAll()], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(b);
      a.download = 'aramirror-os-' + OS.todayStr() + '.json';
      a.click();
    });

    $('#decForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      OS.addDecision({
        q: $('#decQ').value, decision: $('#decD').value, criteria: $('#decC').value,
        risk: $('#decR').value, firstStep: $('#decF').value,
      });
      ['#decQ', '#decD', '#decC', '#decR', '#decF'].forEach((s) => { $(s).value = ''; });
      renderAll();
    });

    OS.onChange(renderAll);
    window.addEventListener('aramos:captured', renderAll);
    renderAll();

    // 정직 로그를 실제로 눈으로 본 순간에만 "웃는돌의 정직" 배지가 열린다
    if ('IntersectionObserver' in window) {
      const hio = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { GM.bump('honest'); hio.disconnect(); } });
      }, { threshold: 0.4 });
      const h = document.querySelector('.ib-honest');
      if (h) hio.observe(h);
    }

    // /inbox?f=todo · ?f=unknown 딥링크 (먼저 말 거는 배너가 여기로 보낸다)
    const q = new URLSearchParams(location.search).get('f');
    if (q === 'todo') document.querySelector('.ibf[data-k="todo"]')?.click();
    if (q === 'unknown') document.querySelector('.ibf[data-v="unknown"]')?.click();
  </script>
</Base>
