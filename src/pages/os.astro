---
import Base from '../layouts/Base.astro';

// 남은 날짜 계산 (2026-12-31 마감)
const modules = [
  { k: 'A', icon: '🎙️', t: '음성 인테이크', d: '회의·컨콜·보이스덤프를 AI가 받아 요약·핵심·액션·인사이트로 자동 정리. 모든 것의 시작점.', c: '#ff5d8f' },
  { k: 'B', icon: '💼', t: '세일즈 코어텍스', d: 'Salesforce식 회사별 카드. 대화→소개서→샘플/견적→테스트→구매수량→AI서버 구독($19)→기기 대수→LTV. 1→10→50→1000개사.', c: '#7aa2ff' },
  { k: 'C', icon: '🛠️', t: 'AS 자동화', d: '정지욱 팀장 대응지식 축적. 고객 단계별 이슈에 AI 봇·이메일·동영상으로 즉시 안내.', c: '#34d3c0' },
  { k: 'D', icon: '📣', t: '마케팅 자동화', d: '이메일·카톡·메시지 자동 발송 + 블로그·SNS 동영상 자동 발행 → 자동 판매.', c: '#ffb457' },
  { k: 'E', icon: '🏭', t: 'ERP·생산·재고', d: '맞춤화장품 자재 구매·재고·생산·폐기 오차 0·낭비 0. ERP↔생산↔재고↔판매↔마케팅 전부 연동.', c: '#a78bfa' },
];

const evalAxes = [
  { n: '①', t: 'AX화', d: '자기 영역 자동화 정도 · 반복·낭비 시간 제거' },
  { n: '②', t: '세일즈 코어텍스 & 세일즈', d: '카드·파이프라인 진전 · 실제 매출·수요 창출' },
  { n: '③', t: '비용·예산 정밀', d: '비용 감축 · 예산을 허투루 없이 치밀·정밀하게 · 편차 관리' },
];

const docs = [
  { t: '대표선언', s: '목표 · 규율', href: '#declare' },
  { t: 'OS 설계도', s: '실행 엔진', href: '#os' },
  { t: '협업·문화', s: '어디서', href: '#culture' },
  { t: '평가·연봉', s: '보상', href: '#eval' },
];
---
<Base title="아람휴비스 OS · 흑자전환 150일">
  <!-- ═══════════ 히어로 ═══════════ -->
  <header class="os-hero">
    <span class="os-orb o1" aria-hidden="true"></span>
    <span class="os-orb o2" aria-hidden="true"></span>
    <div class="wrap os-hero-wrap">
      <p class="os-kicker" data-reveal>🔥 2026 하반기 총력전 · 대표이사 선언</p>
      <h1 class="os-title" data-reveal="60">150일 안에<br /><mark>무조건 흑자 전환</mark>한다.</h1>
      <p class="os-lead" data-reveal="120">그 엔진은 <b>음성부터 시작하는 회사 전체 자동화 OS</b>. 다 같이·다 보이게 만들고, 잘한 사람은 내년 연봉으로 보상한다. 실패하면 회사를 통째로 바꾼다.</p>
      <div class="os-count" data-reveal="160">
        <div class="oc"><b id="daysLeft">–</b><i>남은 날</i></div>
        <div class="oc"><b>7~12월</b><i>흑자 기한</i></div>
        <div class="oc"><b>0</b><i>흘려보낼 시간</i></div>
      </div>
      <div class="os-jump" data-reveal="200">
        {docs.map((d) => (<a href={d.href} class="oj"><b>{d.t}</b><span>{d.s}</span></a>))}
      </div>
    </div>
  </header>

  <!-- ═══════════ 1. 대표선언 ═══════════ -->
  <section id="declare">
    <div class="wrap">
      <p class="section-kicker" data-reveal>1 · 대표선언 — 목표와 규율</p>
      <h2 data-reveal="60">근간: 답 먼저, 데이터로, 예외 없이</h2>
      <div class="os-cards" data-reveal="120">
        <div class="oscard"><span class="ico">🎯</span><h4>목표</h4><p>150일 안에 무조건 흑자 전환. 실패 시 회사 통째로 개편.</p></div>
        <div class="oscard"><span class="ico">⚙️</span><h4>수단 1 · AX 자동화</h4><p>개발팀·서버팀·연구소 전원 소집. 흘려보낸 시간 0, 모든 시간을 농밀하게.</p></div>
        <div class="oscard"><span class="ico">📊</span><h4>수단 2 · 전면 리포팅</h4><p>일/주/월 리포트 + 비용·매출·예산 전부 파일로 공유. 말로 대충 없음.</p></div>
        <div class="oscard warn"><span class="ico">⚖️</span><h4>규율</h4><p>단 한 톨의 누락·오류 → 사유서 · 경위서.</p></div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 2. OS 순환 엔진 ═══════════ -->
  <section id="os" class="os-engine-sec">
    <div class="wrap">
      <p class="section-kicker" data-reveal>2 · 아람휴비스 OS — 실행 엔진</p>
      <h2 data-reveal="60">음성 → 데이터 → 인사이트 → 자동화, 돌수록 발전</h2>
      <div class="os-loop" data-reveal="120">
        <span class="ol">🎙️ 입력<i>음성·회의</i></span><span class="oa">→</span>
        <span class="ol">📥 데이터화<i>요약·핵심</i></span><span class="oa">→</span>
        <span class="ol">🔗 접점<i>연결</i></span><span class="oa">→</span>
        <span class="ol">💡 인사이트<i>통찰</i></span><span class="oa">→</span>
        <span class="ol">⚙️ 자동화<i>프로그램화</i></span>
      </div>
      <p class="os-loopnote" data-reveal="140">↑ 자동화 결과가 다시 회사의 토대가 되어 흘러들어간다 — 돌수록 흑자로 ↑</p>

      <h3 class="os-h3" data-reveal="160">5대 자동화 모듈</h3>
      <div class="os-mods" data-reveal="180">
        {modules.map((m, i) => (
          <div class="osmod" style={`--mc:${m.c}; --d:${i * 90}ms`}>
            <span class="om-k">{m.k}</span>
            <span class="om-ico">{m.icon}</span>
            <h4>{m.t}</h4>
            <p>{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 3. 협업·문화 ═══════════ -->
  <section id="culture" class="os-culture">
    <div class="wrap">
      <p class="section-kicker" data-reveal>3 · 협업·문화 레이어 — 어디서 만드나</p>
      <h2 data-reveal="60">혼자가 아니라 "다 같이, 다 보이게"</h2>
      <div class="cul-grid" data-reveal="120">
        <div class="culc"><b>① 다 같이</b><span>모든 사람의 아이디어·작업물이 재료</span></div>
        <div class="culc"><b>② 게임처럼</b><span>생각이 오가고, 보고 배우고 다시 얹는다</span></div>
        <div class="culc"><b>③ 다 보이게</b><span>과정·결과가 서로에게 보인다. 숨은 진행 없음</span></div>
        <div class="culc"><b>④ 한 곳에서</b><span>개인계정 X. 회사(info)계정 &gt; 팀방 &gt; 프로젝트</span></div>
      </div>
      <div class="cul-rule" data-reveal="160">
        <span class="cr-no">개인 계정에서 혼자 = 일하지 않는 것 → <b>벌(패널티)</b></span>
        <span class="cr-arrow">→</span>
        <span class="cr-ok">한 곳에서 같이·공유하며 일하는 것이 <b>문화로 장착 = 회사의 근간</b></span>
      </div>
    </div>
  </section>

  <!-- ═══════════ 4. 평가·연봉 ═══════════ -->
  <section id="eval">
    <div class="wrap">
      <p class="section-kicker" data-reveal>4 · 평가·보상 — 누가 잘했나</p>
      <h2 data-reveal="60">하반기 실행 → 정확한 평가 → 내년 연봉 즉시 반영</h2>
      <div class="eval-axes" data-reveal="120">
        {evalAxes.map((a) => (<div class="ea"><span class="ea-n">{a.n}</span><h4>{a.t}</h4><p>{a.d}</p></div>))}
      </div>
      <p class="eval-flow" data-reveal="160">하반기 6개월 실행 &nbsp;→&nbsp; 치밀·정밀하게 맞췄는가 &nbsp;→&nbsp; 개인 평가 &nbsp;→&nbsp; <b>🎯 내년도 연봉 반영</b></p>
    </div>
  </section>

  <!-- ═══════════ 마무리 ═══════════ -->
  <section class="os-cta">
    <div class="wrap">
      <h2 data-reveal>치열하게 — 함께 갑시다.</h2>
      <p data-reveal="80">각자의 하루가 농밀하게 쌓이면, 회사의 150일이 된다.</p>
      <p class="os-sign" data-reveal="120">— 대표이사</p>
    </div>
  </section>

  <style is:global>
    .os-hero { position:relative; overflow:hidden; padding: clamp(40px,7vw,80px) 0 clamp(30px,5vw,52px); }
    .os-orb { position:absolute; border-radius:50%; filter:blur(52px); opacity:.5; pointer-events:none; z-index:0; }
    .os-orb.o1 { width:360px; height:360px; top:-120px; right:-70px; background:radial-gradient(circle,#ff5d8f55,transparent 70%); animation:drift 15s var(--ease) infinite; }
    .os-orb.o2 { width:320px; height:320px; bottom:-130px; left:-80px; background:radial-gradient(circle,#7aa2ff4d,transparent 70%); animation:drift 19s var(--ease) infinite reverse; }
    .os-hero-wrap { position:relative; z-index:1; }
    .os-kicker { font-family:var(--mono); font-size:.82rem; letter-spacing:.04em; color:var(--accent); margin-bottom:14px; }
    .os-title { font-size:clamp(2.1rem,6vw,3.6rem); line-height:1.1; letter-spacing:-.03em; font-weight:800; }
    .os-title mark { background:var(--grad); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; padding:0; }
    .os-lead { margin-top:18px; max-width:60ch; color:var(--fg-soft); font-size:1.08rem; line-height:1.65; }
    .os-lead b { color:var(--fg); }
    .os-count { display:flex; gap:14px; margin-top:26px; flex-wrap:wrap; }
    .oc { background:var(--bg-1); border:1px solid var(--line); border-radius:16px; padding:14px 22px; box-shadow:var(--shadow-soft); }
    .oc b { display:block; font-size:1.7rem; font-weight:800; color:var(--accent); font-variant-numeric:tabular-nums; line-height:1; }
    .oc i { font-size:.74rem; color:var(--muted); font-style:normal; }
    .os-jump { display:flex; gap:10px; margin-top:26px; flex-wrap:wrap; }
    .oj { display:flex; flex-direction:column; text-decoration:none; padding:11px 18px; border-radius:14px; background:var(--bg-2); border:1px solid var(--line); transition:transform .16s,border-color .16s; }
    .oj:hover { transform:translateY(-3px); border-color:var(--accent); }
    .oj b { color:var(--fg); font-size:.95rem; } .oj span { color:var(--muted); font-size:.72rem; }

    .os-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:16px; margin-top:24px; }
    .oscard { padding:22px; border-radius:20px; background:var(--bg-1); border:1px solid var(--line); box-shadow:var(--shadow-soft); }
    .oscard .ico { font-size:1.6rem; } .oscard h4 { margin:10px 0 6px; font-size:1.1rem; }
    .oscard p { color:var(--fg-soft); font-size:.92rem; line-height:1.55; }
    .oscard.warn { border-color:color-mix(in srgb,#ff5d5d 40%,var(--line)); background:linear-gradient(160deg,color-mix(in srgb,#ff5d5d 10%,var(--bg-1)),var(--bg-1)); }

    .os-engine-sec { }
    .os-loop { display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; margin-top:24px; }
    .ol { display:flex; flex-direction:column; align-items:center; background:var(--bg-1); border:1px solid var(--line); border-radius:16px; padding:14px 16px; font-weight:800; font-size:.95rem; min-width:96px; box-shadow:var(--shadow-soft); }
    .ol i { font-style:normal; font-weight:400; font-size:.72rem; color:var(--muted); margin-top:4px; }
    .oa { color:var(--accent); font-size:1.3rem; font-weight:800; }
    .os-loopnote { text-align:center; color:var(--muted); font-size:.84rem; margin-top:14px; }
    .os-h3 { margin-top:44px; font-size:1.3rem; }
    .os-mods { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:16px; margin-top:18px; }
    .osmod { position:relative; padding:22px; border-radius:20px; background:linear-gradient(160deg,color-mix(in srgb,var(--mc) 12%,var(--bg-1)),var(--bg-1) 76%); border:1px solid color-mix(in srgb,var(--mc) 28%,var(--line)); box-shadow:var(--shadow-soft); animation:rise .5s var(--ease) both; animation-delay:var(--d); }
    .om-k { position:absolute; top:16px; right:18px; font-family:var(--mono); font-weight:800; font-size:1.4rem; color:var(--mc); opacity:.5; }
    .om-ico { font-size:1.8rem; } .osmod h4 { margin:10px 0 7px; font-size:1.15rem; }
    .osmod p { color:var(--fg-soft); font-size:.9rem; line-height:1.55; }

    .os-culture { }
    .cul-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; margin-top:24px; }
    .culc { padding:18px; border-radius:16px; background:var(--bg-1); border:1px solid var(--line); }
    .culc b { display:block; color:var(--accent); font-size:1.05rem; margin-bottom:5px; }
    .culc span { color:var(--fg-soft); font-size:.88rem; line-height:1.5; }
    .cul-rule { display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-top:22px; padding:20px 24px; border-radius:20px; background:var(--bg-2); border:1px solid var(--line); }
    .cr-no { color:#ff8b8b; font-size:.98rem; } .cr-no b { color:#ff5d5d; }
    .cr-ok { color:var(--fg-soft); font-size:.98rem; } .cr-ok b { color:#6fe08a; }
    .cr-arrow { color:var(--accent); font-size:1.5rem; font-weight:800; }

    .eval-axes { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:16px; margin-top:24px; }
    .ea { padding:22px; border-radius:20px; background:var(--bg-1); border:1px solid var(--line); box-shadow:var(--shadow-soft); }
    .ea-n { font-family:var(--mono); font-weight:800; font-size:1.5rem; color:var(--accent); }
    .ea h4 { margin:8px 0 6px; font-size:1.1rem; } .ea p { color:var(--fg-soft); font-size:.9rem; line-height:1.5; }
    .eval-flow { margin-top:24px; padding:20px 24px; border-radius:20px; background:linear-gradient(120deg,color-mix(in srgb,var(--accent) 14%,var(--bg-1)),var(--bg-1)); border:1px solid color-mix(in srgb,var(--accent) 30%,var(--line)); text-align:center; font-size:1.02rem; font-weight:600; color:var(--fg-soft); }
    .eval-flow b { color:var(--accent); font-size:1.15rem; }

    .os-cta { text-align:center; padding:clamp(50px,8vw,90px) 0; }
    .os-cta h2 { font-size:clamp(1.8rem,5vw,2.8rem); background:var(--grad); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
    .os-cta p { color:var(--fg-soft); margin-top:12px; font-size:1.05rem; }
    .os-sign { color:var(--muted) !important; font-family:var(--mono); margin-top:20px !important; }

    @media (max-width:620px){ .os-loop { gap:6px; } .ol { min-width:78px; padding:10px 10px; font-size:.82rem; } .oa { font-size:1rem; } }
  </style>

  <script is:inline>
    (function(){
      var end = new Date(2026, 11, 31); // 2026-12-31
      var now = new Date();
      var days = Math.max(0, Math.ceil((end - now) / 86400000));
      var el = document.getElementById('daysLeft');
      if (el) el.textContent = String(days);
    })();
  </script>
</Base>
