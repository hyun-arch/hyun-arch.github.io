            ctx.shadowColor = col;
            ctx.globalAlpha = 0.34 + 0.62 * d1;
            ctx.shadowBlur = 8 * d1;
            ctx.fillStyle = col;
            ctx.beginPath(); ctx.arc(x1, y, 1.8 + 4.2 * d1, 0, Math.PI * 2); ctx.fill();
            ctx.globalAlpha = 0.34 + 0.62 * d2;
            ctx.shadowBlur = 8 * d2;
            ctx.beginPath(); ctx.arc(x2, y, 1.8 + 4.2 * d2, 0, Math.PI * 2); ctx.fill();
          }
          ctx.shadowBlur = 0;
          ctx.globalAlpha = 1;
          requestAnimationFrame(draw);
        }
        requestAnimationFrame(draw);
        document.addEventListener('visibilitychange', function () {
          running = !document.hidden;
          if (running) requestAnimationFrame(draw);
        });
      }

      /* ── 3. 필터 ── */
      var grid = document.getElementById('pplGrid');
      var cards = Array.prototype.slice.call(grid ? grid.querySelectorAll('.ppl') : []);
      var countEl = document.getElementById('dnaCount');
      var chipsEl = document.getElementById('dnaChips');
      var noneEl = document.getElementById('pplNone');
      var qEl = document.getElementById('dnaQ');
      var state = { gen: 'all', grp: 'all', gene: null, q: '' };

      function apply() {
        var shown = 0;
        cards.forEach(function (c) {
          var ok = true;
          if (state.gen === '1' || state.gen === '2') ok = ok && c.dataset.gen === state.gen;
          else if (state.gen === 'both') ok = ok && c.dataset.both === '1';
          if (state.grp !== 'all') ok = ok && c.dataset.grp === state.grp;
          if (state.gene) ok = ok && c.dataset.gene === state.gene;
          if (state.q) ok = ok && (c.dataset.hay || '').indexOf(state.q) !== -1;
          c.hidden = !ok;
          if (ok) shown++;
        });
        if (countEl) countEl.textContent = shown + '명';
        if (noneEl) noneEl.hidden = shown !== 0;
        renderChips();
      }
      function renderChips() {
        if (!chipsEl) return;
        var out = [];
        if (state.gen !== 'all') out.push(state.gen === 'both' ? '1·2기 연속' : state.gen + '기');
        if (state.grp !== 'all') out.push(state.grp);
        if (state.gene && GENES[state.gene]) out.push(GENES[state.gene].ic + ' ' + GENES[state.gene].ko);
        if (state.q) out.push('“' + state.q + '”');
        chipsEl.innerHTML = out.map(function (x) { return '<span class="dna-chip">' + x + '</span>'; }).join('');
      }

      document.querySelectorAll('[data-gen]').forEach(function (b) {
        if (b.classList.contains('ppl')) return;
        b.addEventListener('click', function () {
          state.gen = b.dataset.gen;
          document.querySelectorAll('.fl[data-gen]').forEach(function (x) { x.classList.toggle('on', x === b); });
          apply();
        });
      });
      document.querySelectorAll('.fl[data-grp]').forEach(function (b) {
        b.addEventListener('click', function () {
          state.grp = b.dataset.grp;
          document.querySelectorAll('.fl[data-grp]').forEach(function (x) { x.classList.toggle('on', x === b); });
          apply();
        });
      });
      document.querySelectorAll('.gene-card').forEach(function (b) {
        b.addEventListener('click', function () {
          var id = b.dataset.gene;
          state.gene = state.gene === id ? null : id;
          document.querySelectorAll('.gene-card').forEach(function (x) {
            x.classList.toggle('on', x.dataset.gene === state.gene);
          });
          apply();
          var r = document.getElementById('roster');
          if (r && state.gene) r.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        });
      });
      if (qEl) {
        var tq;
        qEl.addEventListener('input', function () {
          clearTimeout(tq);
          tq = setTimeout(function () { state.q = qEl.value.trim().toLowerCase(); apply(); }, 140);
        });
      }
      var resetEl = document.getElementById('dnaReset');
      if (resetEl) {
        resetEl.addEventListener('click', function () {
          state = { gen: 'all', grp: 'all', gene: null, q: '' };
          if (qEl) qEl.value = '';
          document.querySelectorAll('.fl[data-gen]').forEach(function (x) { x.classList.toggle('on', x.dataset.gen === 'all'); });
          document.querySelectorAll('.fl[data-grp]').forEach(function (x) { x.classList.toggle('on', x.dataset.grp === 'all'); });
          document.querySelectorAll('.gene-card').forEach(function (x) { x.classList.remove('on'); });
          apply();
        });
      }

      /* ── 4. 상세 시트 ── */
      var sheet = document.getElementById('dnaSheet');
      var scrim = document.getElementById('sheetScrim');
      var body = document.getElementById('sheetBody');
      var posEl = document.getElementById('sheetPos');
      var prevB = document.getElementById('sheetPrev');
      var nextB = document.getElementById('sheetNext');
      var cur = -1;
      var lastFocus = null;

      function esc(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function visibleList() {
        return cards.filter(function (c) { return !c.hidden; }).map(function (c) { return Number(c.dataset.i); });
      }
      function render(i) {
        var p = PEOPLE[i];
        if (!p) return;
        var g = GENES[p.gene] || { ic: '·', ko: '—', c: '#999' };
        var isEmpty = p.gene === 'empty';
        var h = '';
        h += '<div class="sh-top">';
        h += '<span class="sh-badge">' + esc(p.both ? '1·2기 연속' : p.gen + '기') + '</span>';
        h += '<span class="sh-grp">' + esc(p.g) + '</span>';
        h += '<span class="sh-gene">' + g.ic + ' ' + esc(g.ko) + '</span>';
        h += '</div>';
        h += '<h3 class="sh-name">' + esc(p.n) + (p.self ? ' <i class="ppl-me">나</i>' : '') + '</h3>';
        h += '<p class="sh-job">' + esc(p.job || '—') + '</p>';
        if (isEmpty) {
          h += '<p class="sh-empty">' + esc(p.core) + '<br /><br />명단에서 지우지 않는다. 빈칸도 기록이다.</p>';
        } else {
          h += '<span class="sh-lab">대표작</span><p class="sh-work">' + esc(p.work) + '</p>';
          h += '<span class="sh-lab">핵심 코어 · 이 사람의 장점</span><p class="sh-p">' + esc(p.core) + '</p>';
          if (p.quote) h += '<span class="sh-lab">그가 남긴 문장</span><p class="sh-quote">' + esc(p.quote) + '</p>';
          if (p.apply) h += '<span class="sh-lab">→ 아람미러에 반영</span><p class="sh-apply">' + esc(p.apply) + '</p>';
          if (p.parts && p.parts.length) {
            h += '<span class="sh-lab">🧬 이 코어가 실제로 간 곳 — ' + p.parts.length + '개 부품</span><div class="sh-parts">';
            p.parts.forEach(function (q) {
              const st = { live: '작동 중', building: '만드는 중', seed: '내용 있음', idea: '다음 칸' }[q.status] || q.status;
              h += '<a class="sh-part ' + q.status + '" href="' + esc(q.href) + '"><i></i><b>' + esc(q.t) + '</b>' +
                   '<span>' + esc(q.domain) + ' · ' + st + '</span></a>';
            });
            h += '</div>';
          } else {
            h += '<p class="sh-nopart">아직 이 사람의 코어가 부품으로 연결되지 않았습니다. ' +
                 '위 "아람미러에 반영"이 다음에 만들 칸입니다.</p>';
          }
        }
        body.innerHTML = h;
        sheet.style.setProperty('--gc', g.c);
        body.scrollTop = 0;
        var vis = visibleList();
        var at = vis.indexOf(i);
        if (posEl) posEl.textContent = (at >= 0 ? (at + 1) + ' / ' + vis.length : '—');
        if (prevB) prevB.disabled = at <= 0;
        if (nextB) nextB.disabled = at < 0 || at >= vis.length - 1;
        cur = i;
      }
      function open(i, trigger) {
        lastFocus = trigger || document.activeElement;
        sheet.hidden = false; scrim.hidden = false;
        document.body.style.overflow = 'hidden';
        render(i);
        var x = document.getElementById('sheetX');
        if (x) x.focus();
      }
      function close() {
        sheet.hidden = true; scrim.hidden = true;
        document.body.style.overflow = '';
        cur = -1;
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      function move(d) {
        var vis = visibleList();
        var at = vis.indexOf(cur);
        if (at < 0) return;
        var nx = at + d;
        if (nx < 0 || nx >= vis.length) return;
        render(vis[nx]);
      }
      cards.forEach(function (c) {
        c.addEventListener('click', function () { open(Number(c.dataset.i), c); });
      });
      if (scrim) scrim.addEventListener('click', close);
      var xB = document.getElementById('sheetX');
      if (xB) xB.addEventListener('click', close);
      if (prevB) prevB.addEventListener('click', function () { move(-1); });
      if (nextB) nextB.addEventListener('click', function () { move(1); });
      document.addEventListener('keydown', function (e) {
        if (sheet.hidden) return;
        if (e.key === 'Escape') { close(); }
        else if (e.key === 'ArrowLeft') { move(-1); }
        else if (e.key === 'ArrowRight') { move(1); }
      });

      apply();
    })();
  </script>
</Base>
