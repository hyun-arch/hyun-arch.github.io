---
import Base from '../layouts/Base.astro';
import { people, genes, geneMap, stats, meta } from '../data/dna.js';
import { graftStats, partsFrom } from '../data/mirror.js';

const s = stats();
const gs = graftStats();
const groups = ['1조', '2조', '3조', '4조', '5조', '6조'];

// ── 사람 → 실제로 이식된 부품 (양방향 연결) ──
const partsOf = {};
people.forEach((p) => {
  if (p.gene === 'empty') return;
  const ps = partsFrom(p.n);
  if (ps.length) partsOf[p.n] = ps;
});
const linkedPeople = Object.keys(partsOf).length;

// ── 유전자별 이식 현황 ──
const geneParts = {};
gs.items.forEach((i) => {
  if (!i.gene) return;
  (geneParts[i.gene] = geneParts[i.gene] || []).push({
    t: i.t, href: i.to || '/m/' + i.slug, status: i.status, from: i.from || null,
  });
});

// ── 지금 실제로 작동하는 크루 부품 (이 페이지의 핵심 증거) ──
const liveParts = gs.items
  .filter((i) => i.from && i.status === 'live')
  .map((i) => ({ t: i.t, href: i.to || '/m/' + i.slug, from: i.from, gene: i.gene }));
const quotes = people
  .filter((p) => p.quote && p.quote.length > 12 && !p.self)
  .map((p) => ({ q: p.quote.replace(/^"|"$/g, ''), n: p.n }));
const marquee = quotes.slice(0, 26);
// 상세 시트용 최소 페이로드
const payload = people.map((p, i) => ({
  i, n: p.n, g: p.g, gen: p.gen, both: !!p.both, self: !!p.self,
  job: p.job, work: p.work, core: p.core, quote: p.quote, apply: p.apply, gene: p.gene,
  parts: partsOf[p.n] || [],   // 이 사람 코어가 실제로 간 곳
}));
const genePayload = genes.map((g) => ({ id: g.id, ko: g.ko, en: g.en, ic: g.ic, c: g.c, desc: g.desc }));
---

<Base title={`아람미러 DNA — 스폰지클럽 1·2기 ${s.total}명의 코어`}>
  <div class="dna-page">

    <!-- ═══════════ HERO ═══════════ -->
    <section class="dna-hero">
      <canvas id="helix" aria-hidden="true"></canvas>
      <div class="dna-hero-veil"></div>
      <div class="wrap dna-hero-in">
        <p class="dna-kicker" data-reveal>SPONGECLUB S1 · S2 &nbsp;/&nbsp; ALL {s.total} ENTRIES &nbsp;/&nbsp; DNA EXTRACTION</p>
        <h1 data-reveal="80">
          {s.total}명의 <em>코어</em>를<br />
          전부 흡수했다.
        </h1>
        <p class="dna-sub" data-reveal="180">
          스폰지클럽 <b>1기 {s.gen1}명</b> · <b>2기 {s.gen2}명</b>의 과제 원문 <b>{meta.raw}</b>를 한 장도 빠뜨리지 않고 읽고,<br />
          각자의 코어를 <b>12개 유전자</b>로 뽑아 아라미러 지도에 <b>{gs.fromCrew}개 부품</b>으로 심었다.
          그중 <b>{gs.crewLive}개는 지금 이 순간 코드로 돌아간다.</b><br />
          <span class="dna-sub-dim">감상문이 아니라 이식 기록이다 — 지금 <kbd>C</kbd>를 눌러보시면 그중 하나가 열린다.</span>
        </p>

        <div class="dna-counts" data-reveal="260">
          <div class="dna-count"><b class="cnum" data-to={s.total}>0</b><span>정독한 크루</span></div>
          <div class="dna-count"><b class="cnum" data-to={gs.fromCrew}>0</b><span>이식된 부품</span></div>
          <div class="dna-count"><b class="cnum" data-to={gs.crewLive}>0</b><span>지금 작동 중</span></div>
          <div class="dna-count"><b class="cnum" data-to={gs.total}>0</b><span>지도 전체 부품</span></div>
          <div class="dna-count"><b class="cnum" data-to={1468}>0</b><span>정독 문서</span></div>
        </div>

        <div class="dna-cta" data-reveal="340">
          <a class="dna-btn" href="#live">지금 작동하는 것 {liveParts.length}개</a>
          <a class="dna-btn ghost" href="#roster">{s.total}명 전원 명단</a>
        </div>
      </div>
      <div class="dna-scroll" aria-hidden="true"><span></span></div>
    </section>

    <!-- ═══════════ 인용 마퀴 ═══════════ -->
    <section class="dna-marquee" aria-label="크루들의 문장">
      <div class="mq-track">
        {[0, 1].map((dup) => (
          <div class="mq-row" aria-hidden={dup === 1 ? 'true' : undefined}>
            {marquee.map((m) => (
              <span class="mq-item"><i>“</i>{m.q}<i>”</i><b>{m.n}</b></span>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════ 유전자 12 ═══════════ -->
    <section id="genes" class="dna-sec">
      <div class="wrap">
        <p class="section-kicker" data-reveal>THE 12 GENES</p>
        <h2 data-reveal="60">{s.total}명에게서 반복해서<br /><mark>검출된 12가지</mark></h2>
        <p class="lead" data-reveal="120">
          서로 모르는 {s.uniq}명이, 서로 다른 문제를 풀면서 같은 결론에 도달한 지점들이다.
          한 사람의 통찰은 우연일 수 있지만 열 사람이 같은 곳에 닿으면 그건 법칙이다.
          카드를 누르면 그 유전자를 가진 사람들만 아래 명단에 남는다.
        </p>

        <div class="gene-grid">
          {genes.filter((g) => g.id !== 'empty').map((g, i) => (
            <button class="gene-card" data-gene={g.id} style={`--gc:${g.c}`} data-reveal={String(40 + i * 26)} type="button">
              <span class="gene-ic">{g.ic}</span>
              <span class="gene-n">{s.byGene[g.id] || 0}<i>명</i></span>
              <h3>{g.ko}</h3>
              <p class="gene-en">{g.en}</p>
              <p class="gene-desc">{g.desc}</p>
              <span class="gene-go">이 유전자 보유자 보기 →</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ 지금 작동하는 것 ═══════════ -->
    <section class="dna-sec dna-live" id="live">
      <div class="wrap">
        <p class="section-kicker" data-reveal>NOW RUNNING · {liveParts.length}</p>
        <h2 data-reveal="60">읽은 게 아니라 <mark>지금 돌아가는 것</mark></h2>
        <p class="lead" data-reveal="120">
          아래는 크루의 코어가 아라미러 <b>코드가 되어 지금 이 순간 작동하는</b> 부품이다.
          누르면 실제로 그 기능이 열린다. 지금 이 화면 오른쪽 아래 <b>⚡</b> 버튼도 그중 하나다 —
          아무 페이지에서나 <kbd>C</kbd>를 눌러보시면 됩니다.
        </p>

        <div class="lv-grid">
          {liveParts.map((p, i) => {
            const g = p.gene ? geneMap[p.gene] : null;
            return (
              <a class="lv" href={p.href} style={`--gc:${g ? g.c : 'var(--accent)'}`} data-reveal={String(30 + i * 22)}>
                <span class="lv-dot" aria-hidden="true"></span>
                <span class="lv-t">{p.t}</span>
                <span class="lv-from">← {p.from}</span>
                {g && <span class="lv-gene">{g.ic} {g.ko}</span>}
                <span class="lv-go">열기 →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═══════════ 이식 현황판 ═══════════ -->
    <section class="dna-sec dna-applied">
      <div class="wrap">
        <p class="section-kicker" data-reveal>TRANSPLANT BOARD</p>
        <h2 data-reveal="60">유전자가 <mark>부품이 된 자리</mark></h2>
        <p class="lead" data-reveal="120">
          아라미러 전체 지도는 <b>{gs.total}개 부품</b>이고, 그중 <b>{gs.fromCrew}개</b>가 크루에게서 왔다.
          어느 유전자가 어느 부품이 됐는지, 그게 지금 <b>작동 중</b>인지 <b>만드는 중</b>인지 <b>다음 칸</b>인지를 있는 그대로 편다.
          부품 이름을 누르면 그 부품 페이지로 간다.
        </p>

        <div class="tb-sum" data-reveal="150">
          <span class="tb-chip live"><b>{gs.crewLive}</b> 작동 중</span>
          <span class="tb-chip building"><b>{gs.crewBuilding}</b> 만드는 중</span>
          <span class="tb-chip idea"><b>{gs.crewSeedIdea}</b> 다음 칸</span>
          <span class="tb-chip"><b>{linkedPeople}</b>명의 코어가 부품으로 연결됨</span>
        </div>

        <div class="tb-list">
          {genes.filter((g) => g.id !== 'empty' && geneParts[g.id]).map((g, i) => (
            <article class="tb" style={`--gc:${g.c}`} data-reveal={String(30 + i * 18)}>
              <div class="tb-head">
                <span class="tb-ic">{g.ic}</span>
                <h3>{g.ko}</h3>
                <span class="tb-en">{g.en}</span>
                <span class="tb-n">{geneParts[g.id].length}개 부품 · 보유자 {s.byGene[g.id] || 0}명</span>
              </div>
              <p class="tb-desc">{g.desc}</p>
              <div class="tb-parts">
                {geneParts[g.id].map((p) => (
                  <a class={`tp ${p.status}`} href={p.href}>
                    <i class="tp-dot"></i>
                    <b>{p.t}</b>
                    {p.from && <span class="tp-from">← {p.from}</span>}
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ 명단 ═══════════ -->
    <section id="roster" class="dna-sec dna-roster">
      <div class="wrap">
        <p class="section-kicker" data-reveal>THE ROSTER · {s.total}</p>
        <h2 data-reveal="60">한 사람도 <mark>빼지 않았다</mark></h2>
        <p class="lead" data-reveal="120">
          제출이 비어 있는 {s.empty}명도 명단에서 지우지 않았다. 빈칸도 기록이다.
          카드를 누르면 그 사람의 대표작 · 핵심 코어 · 그가 남긴 문장 · 아람미러 적용점이 열린다.
        </p>
      </div>

      <div class="dna-bar" id="dnaBar">
        <div class="wrap dna-bar-in">
          <div class="fl-group" role="group" aria-label="기수">
            <button class="fl on" data-gen="all" type="button">전체</button>
            <button class="fl" data-gen="1" type="button">1기</button>
            <button class="fl" data-gen="2" type="button">2기</button>
            <button class="fl" data-gen="both" type="button">1·2기 연속</button>
          </div>
          <div class="fl-group" role="group" aria-label="조">
            <button class="fl on" data-grp="all" type="button">전조</button>
            {groups.map((g) => <button class="fl" data-grp={g} type="button">{g}</button>)}
          </div>
          <div class="fl-right">
            <label class="fl-search">
              <span class="sr-only">이름·키워드 검색</span>
              <input id="dnaQ" type="search" placeholder="이름 · 대표작 · 키워드 검색" autocomplete="off" />
            </label>
            <button class="fl fl-reset" id="dnaReset" type="button">초기화</button>
          </div>
        </div>
        <div class="wrap dna-bar-state">
          <span id="dnaCount">{s.total}명</span>
          <span class="dna-chip-wrap" id="dnaChips"></span>
        </div>
      </div>

      <div class="wrap">
        <div class="ppl-grid" id="pplGrid">
          {people.map((p, i) => {
            const g = geneMap[p.gene];
            const hay = `${p.n} ${p.job} ${p.work} ${p.core} ${p.quote} ${p.apply}`.toLowerCase();
            return (
              <button
                class={`ppl ${p.gene === 'empty' ? 'is-empty' : ''} ${p.self ? 'is-self' : ''}`}
                style={`--gc:${g.c}`}
                type="button"
                data-i={i}
                data-gen={p.gen}
                data-both={p.both ? '1' : '0'}
                data-grp={p.g}
                data-gene={p.gene}
                data-hay={hay}
              >
                <span class="ppl-top">
                  <span class={`ppl-gen g${p.gen}`}>{p.both ? '1·2기' : `${p.gen}기`}</span>
                  <span class="ppl-grp">{p.g}</span>
                  <span class="ppl-gene" title={g.ko}>{g.ic}</span>
                </span>
                <span class="ppl-name">{p.n}{p.self && <i class="ppl-me">나</i>}</span>
                <span class="ppl-job">{p.job}</span>
                <span class="ppl-work">{p.work}</span>
                <span class="ppl-core">{p.core}</span>
                <span class="ppl-more">자세히 →</span>
              </button>
            );
          })}
        </div>
        <p class="ppl-none" id="pplNone" hidden>조건에 맞는 사람이 없습니다. 조건을 넓혀보세요.</p>
      </div>
    </section>

    <!-- ═══════════ 결론 ═══════════ -->
    <section class="dna-sec dna-end">
      <div class="wrap">
        <p class="section-kicker" data-reveal>ONE LINE</p>
        <blockquote class="dna-quote" data-reveal="60">
          한 사람의 통찰은 우연이다.<br />
          <mark>{s.total}명이 같은 곳에 닿으면</mark> 그건 법칙이다.
        </blockquote>
        <p class="dna-end-p" data-reveal="140">
          이 페이지는 아람미러가 무엇을 물려받았는지에 대한 영수증이다.
          명단 <b>{s.total}</b>건 = 1기 {s.gen1} + 2기 {s.gen2}, 그중 <b>{s.both}</b>명은 두 기수를 모두 뛰었으니
          실제 사람은 <b>{s.uniq}</b>명이다.
          출처 — <b>{meta.source1}</b> · <b>{meta.source2}</b> · 전수 정독 {meta.read}.
          제출이 비어 있던 자리도 그대로 두었다. 다음 기수의 누군가가 채울 자리이기 때문이다.
        </p>
        <div class="dna-cta" data-reveal="200">
          <a class="dna-btn dark" href="/mission-rank">🏆 4주 과제 랭킹</a>
          <a class="dna-btn ghost dark" href="/spongeclub">스폰지클럽 기획 전수</a>
          <a class="dna-btn ghost dark" href="/build-logs">Build Logs</a>
        </div>
      </div>
    </section>

    <!-- ═══════════ 상세 시트 ═══════════ -->
    <div class="sheet-scrim" id="sheetScrim" hidden></div>
    <aside class="dna-sheet" id="dnaSheet" hidden aria-modal="true" role="dialog" aria-label="크루 상세">
      <button class="sheet-x" id="sheetX" type="button" aria-label="닫기">✕</button>
      <div class="sheet-body" id="sheetBody"></div>
      <nav class="sheet-nav">
        <button id="sheetPrev" type="button">← 이전</button>
        <span id="sheetPos"></span>
        <button id="sheetNext" type="button">다음 →</button>
      </nav>
    </aside>
  </div>

  <script type="application/json" id="dnaData" set:html={JSON.stringify({ people: payload, genes: genePayload })} />

  <style is:global>
    /* ══════════════ DNA PAGE ══════════════ */
    .dna-page { --ink:#171210; --ink2:#241c18; }
    .dna-page .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }

    /* ── HERO ── */
    .dna-hero {
      position:relative; min-height:min(100vh, 860px); display:flex; align-items:center;
      background: radial-gradient(70rem 50rem at 78% 8%, #34211a 0%, transparent 62%),
                  radial-gradient(56rem 46rem at 10% 92%, #2a1a2c 0%, transparent 60%),
                  linear-gradient(160deg, #1b1411 0%, #120e0c 100%);
      overflow:hidden; padding:120px 0 96px; border-top:0;
    }
    .dna-hero #helix { position:absolute; inset:0; width:100%; height:100%; opacity:1; }
    .dna-hero-veil {
      position:absolute; inset:0; pointer-events:none;
      background: radial-gradient(48% 46% at 50% 44%, rgba(18,14,12,.66) 0%, rgba(18,14,12,.30) 62%, transparent 100%);
    }
    .dna-hero-in { position:relative; z-index:2; text-align:center; }
    .dna-kicker {
      display:inline-block; font-family:var(--mono); font-size:.68rem; letter-spacing:.22em;
      color:#ffd9c0; background:rgba(255,255,255,.06); border:1px solid rgba(255,180,87,.28);
      padding:8px 18px; border-radius:999px; margin:0 0 30px; backdrop-filter:blur(8px);
    }
    .dna-hero h1 {
      font-size:clamp(2.7rem, 8vw, 6.4rem); line-height:.98; letter-spacing:-.05em; font-weight:800;
      color:#fff7f0; margin:0 0 26px;
    }
    .dna-hero h1 em {
      font-style:normal; background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;
      position:relative;
    }
    .dna-sub { color:#e2cfc2; font-size:clamp(1rem,1.9vw,1.22rem); line-height:1.72; margin:0 auto; max-width:720px; }
    .dna-sub b { color:#fff; font-weight:700; }
    .dna-sub-dim { color:#a8938a; display:inline-block; margin-top:8px; }

    .dna-counts { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin:44px 0 0; }
    .dna-count {
      min-width:110px; padding:18px 20px; border-radius:18px;
      background:rgba(255,255,255,.045); border:1px solid rgba(255,255,255,.10); backdrop-filter:blur(10px);
      transition:transform .35s var(--ease), border-color .35s var(--ease), background .35s var(--ease);
    }
    .dna-count:hover { transform:translateY(-5px); border-color:rgba(255,180,87,.5); background:rgba(255,255,255,.08); }
    .dna-count b {
      display:block; font-family:var(--mono); font-size:2.1rem; font-weight:600; letter-spacing:-.03em;
      background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;
      font-variant-numeric:tabular-nums;
    }
    .dna-count span { display:block; color:#b8a196; font-size:.8rem; margin-top:2px; letter-spacing:.02em; }

    .dna-cta { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:38px; }
    .dna-btn {
      display:inline-flex; align-items:center; gap:8px; padding:14px 28px; border-radius:999px;
      font-weight:700; font-size:.98rem; background:var(--grad); color:#1a0f09;
      box-shadow:0 12px 30px rgba(255,106,61,.28); transition:transform .25s var(--ease), box-shadow .25s var(--ease);
    }
    .dna-btn:hover { transform:translateY(-3px); box-shadow:0 20px 46px rgba(255,106,61,.42); }
    .dna-btn.ghost { background:rgba(255,255,255,.06); color:#ffe7d8; border:1px solid rgba(255,255,255,.18); box-shadow:none; }
    .dna-btn.ghost:hover { border-color:var(--a2); background:rgba(255,255,255,.12); }
    .dna-btn.dark { color:#fff; }
    .dna-btn.ghost.dark { color:var(--fg); background:var(--bg-1); border:1px solid var(--line); }
    .dna-btn.ghost.dark:hover { border-color:var(--accent); background:var(--accent-soft); }

    .dna-scroll { position:absolute; left:50%; bottom:26px; transform:translateX(-50%); z-index:2; }
    .dna-scroll span {
      display:block; width:22px; height:36px; border:1px solid rgba(255,255,255,.3); border-radius:12px; position:relative;
    }
    .dna-scroll span::after {
      content:""; position:absolute; left:50%; top:8px; width:3px; height:7px; border-radius:2px;
      background:var(--a2); transform:translateX(-50%); animation:dnaScroll 1.8s var(--ease) infinite;
    }
    @keyframes dnaScroll { 0%{opacity:0;transform:translate(-50%,0)} 30%{opacity:1} 100%{opacity:0;transform:translate(-50%,14px)} }

    /* ── 마퀴 ── */
    .dna-marquee {
      padding:0; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
      background:var(--bg-1); overflow:hidden;
    }
    .mq-track { display:flex; width:max-content; animation:mqRun 90s linear infinite; }
    .mq-track:hover { animation-play-state:paused; }
    .mq-row { display:flex; gap:0; }
    .mq-item {
