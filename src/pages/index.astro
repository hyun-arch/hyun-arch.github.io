---
import Base from '../layouts/Base.astro';
import { logs } from '../data/logs.js';
import { domains, statusMeta } from '../data/mirror.js';
const latestLogs = logs.slice(0, 3);
const hrefOf = (it) => it.to || ('/m/' + it.slug);

function counts(d) {
  let live = 0, total = 0, building = 0;
  d.branches.forEach((b) => b.items.forEach((it) => {
    total++;
    if (it.status === 'live') live++;
    if (it.status === 'building') building++;
  }));
  return { live, total, building, branches: d.branches.length };
}

const perDomain = domains.map((d) => ({ ...d, c: counts(d) }));
const totalLive = perDomain.reduce((s, d) => s + d.c.live, 0);
const totalItems = perDomain.reduce((s, d) => s + d.c.total, 0);
const totalBuilding = perDomain.reduce((s, d) => s + d.c.building, 0);
const donePct = Math.round((totalLive / totalItems) * 100);

// 빠른 실행 — 각 항목이 "눈 달린 꼬마 캐릭터"가 된다
const apps = [
  { emoji: '🔥', label: '흑자전환 OS', sub: '150일 총력전', href: '/os',          c: '#ff5d8f', m: 'hop' },
  { emoji: '🗺️', label: '거울 지도', sub: '5대륙 탐험', href: '#map',          c: '#f2622f', m: 'hop' },
  { emoji: '💬', label: '되묻기 멘토', sub: '생각 끌어내기', href: '/ask',         c: '#ff5d8f', m: 'sway' },
  { emoji: '🎛️', label: '총괄실', sub: '오늘 한눈에', href: '/hq/index.html', c: '#ffb457', m: 'bob' },
  { emoji: '📚', label: '책장', sub: '던지면 분류', href: '/shelf',        c: '#34d3c0', m: 'spin' },
  { emoji: '📅', label: '달력', sub: '일정·할일', href: '/calendar',     c: '#7aa2ff', m: 'bob' },
  { emoji: '🌊', label: '몰입 플로우', sub: '집중 타이머', href: '/flow',        c: '#a78bfa', m: 'hop' },
  { emoji: '📥', label: '자료실', sub: '모아둔 것', href: '/archive',     c: '#ff8a4d', m: 'sway' },
  { emoji: '🏀', label: 'GTB 클럽', sub: '새벽 농구', href: '/gtb',         c: '#ff9a3d', m: 'spin' },
];

const donutC = 2 * Math.PI * 26;
---
<Base title="Home">  <!-- ═══════════ 아라미 데크 : 한 화면에 다 있다 ═══════════ -->
  <header class="deck">
    <span class="gh-orb o1" aria-hidden="true"></span>
    <span class="gh-orb o2" aria-hidden="true"></span>
    <div class="wrap deck-wrap">

      <!-- ── 인사 + 레벨 ── -->
      <div class="dk-top">
        <div class="dk-hello" data-reveal>
          <p class="dk-kicker">🪞 Aramirror · 아람, 아름다운 사람</p>
          <h1 class="dk-title">안녕하세요 사장님 <span class="wave">👋</span><br /><mark>아라미</mark>가 오늘도 켜졌어요.</h1>
          <p class="dk-say" id="dkSay">던지면 알아서 제자리에 쌓이고, 쌓인 게 한 칸씩 올라가요.</p>
        </div>

        <div class="dk-level" data-reveal="90" id="dkLevel">
          <div class="dk-ring">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle class="rk-bg" cx="60" cy="60" r="52" />
              <circle class="rk-fg" id="rkFg" cx="60" cy="60" r="52" />
            </svg>
            <span class="rk-mid">
              <b class="rk-ic" id="rkIc">🌱</b>
              <b class="rk-lv" id="rkLv">Lv 1</b>
              <i class="rk-name" id="rkName">씨앗</i>
            </span>
          </div>
          <div class="dk-lvinfo">
            <div class="dk-xpbar"><i id="dkXpFill" style="width:4%"></i></div>
            <p class="dk-xptext"><b id="dkXp">0</b> XP · 다음 <b id="dkXpNext">30</b> 까지 <b id="dkXpLeft">30</b></p>
            <div class="dk-chips">
              <span class="dk-chip"><b id="dkStreak">0</b><i>🔥 연속</i></span>
              <span class="dk-chip"><b id="dkToday">0</b><i>오늘</i></span>
              <span class="dk-chip"><b id="dkAsset">0</b><i>💎 자산</i></span>
              <span class="dk-chip"><b id="dkRate">0%</b><i>승격률</i></span>
            </div>
          </div>
        </div>
      </div>

      <!-- ── 주인공 : 한 줄 입력 ── -->
      <form class="dk-cap" id="dkCapForm" data-reveal="140" autocomplete="off">
        <span class="dk-cap-ic" aria-hidden="true">⚡</span>
        <input id="dkIn" type="text" placeholder="아무거나 한 줄 — 알아서 분류돼요.  예) 내일 10시 경영회의 / 이번 주까지 지표 정리 #경영" aria-label="한 줄 던지기" />
        <button type="submit" class="dk-cap-btn">던지기</button>
        <div class="dk-route" id="dkRoute" hidden></div>
      </form>

      <!-- ── 오늘의 미션 · 파이프라인 · 다음 한 칸 ── -->
      <div class="dk-grid" data-reveal="180">

        <section class="dk-card dk-miss">
          <p class="dk-h">🎯 오늘의 미션 <span class="dk-h-n" id="dkMissN">0/3</span></p>
          <ul class="miss-list" id="dkMissList"></ul>
          <div class="miss-bar"><i id="dkMissFill" style="width:0%"></i></div>
        </section>

        <section class="dk-card dk-pipe">
          <p class="dk-h">⬆ 승격 파이프라인 <a class="dk-h-go" href="/inbox">열기 →</a></p>
          <div class="pflow" id="dkPipe">
            <a class="pf" href="/inbox" data-s="inbox"><b id="pfInbox">0</b><span>📥 인박스</span></a>
            <i class="pf-arrow"><em></em></i>
            <a class="pf" href="/inbox" data-s="sorted"><b id="pfSorted">0</b><span>🗂 정리됨</span></a>
            <i class="pf-arrow"><em></em></i>
            <a class="pf" href="/inbox" data-s="wiki"><b id="pfWiki">0</b><span>🧠 지식</span></a>
            <i class="pf-arrow"><em></em></i>
            <a class="pf pf-goal" href="/inbox" data-s="asset"><b id="pfAsset">0</b><span>💎 자산</span></a>
          </div>
          <p class="pf-note" id="dkPipeNote">아직 던진 게 없어요. 위에 한 줄 넣어보세요.</p>
        </section>

        <section class="dk-card dk-next">
          <p class="dk-h">👉 다음 한 칸</p>
          <a class="nx" id="dkNext" href="#capture">
            <span class="nx-ic" id="nxIc">⚡</span>
            <span class="nx-body">
              <b id="nxT">아무거나 한 줄 던져보세요</b>
              <i id="nxD">이 시스템의 입구는 그거 하나예요.</i>
            </span>
            <span class="nx-xp" id="nxXp">+2 XP</span>
          </a>
        </section>
      </div>

      <!-- ── 업적 ── -->
      <div class="dk-grid2 one" data-reveal="220">

        <section class="dk-card dk-badge">
          <p class="dk-h">🏅 업적 <span class="dk-h-n" id="dkBadgeN">0/18</span>
            <button class="dk-h-go" id="dkBadgeToggle" type="button">전부 보기</button></p>
          <div class="bg-grid" id="dkBadges"></div>
        </section>
      </div>
    </div>
  </header>

  <!-- 배지 획득 축하 -->
  <div class="cele" id="cele" hidden>
    <canvas id="celeCv" aria-hidden="true"></canvas>
    <div class="cele-card" id="celeCard"></div>
  </div>

  <!-- ═══════════ 빠른 실행 : 캐릭터 런처 ═══════════ -->
  <section class="applaunch">
    <div class="wrap">
      <p class="section-kicker" data-reveal>Quick Launch</p>
      <h2 data-reveal="60">한 번에 열기 — 꼬마들을 눌러요</h2>
      <p class="lead" data-reveal="120">자주 쓰는 곳마다 작은 친구가 살아있어요. 마우스를 올리면 폴짝 뛰어요.</p>
      <div class="crit-grid" data-reveal="160">
        {apps.map((a, i) => (
          <a class={`critc m-${a.m}`} href={a.href} style={`--ac:${a.c}; --d:${i * 120}ms`}>
            <span class="crit">
              <span class="crit-shadow"></span>
              <span class="crit-body">
                <span class="crit-eye l"></span>
                <span class="crit-eye r"></span>
                <span class="crit-cheek l"></span>
                <span class="crit-cheek r"></span>
                <span class="crit-badge">{a.emoji}</span>
              </span>
            </span>
            <span class="crit-label">{a.label}</span>
            <span class="crit-sub">{a.sub}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 거울 지도 (병합) : 대륙 개요 ↔ 상세 드릴다운 ═══════════ -->
  <section class="map-sec" id="map">
    <div class="wrap">
      <p class="section-kicker" data-reveal>The Mirror · 5 Continents</p>
      <h2 data-reveal="60">나를 비추는 다섯 대륙</h2>
      <p class="lead" data-reveal="120">큰 그림에서 골목까지 — 대륙을 눌러 안으로 들어가요. 링이 찰수록 성장한 거예요.</p>

      <div class="view" id="view" data-level="overview" data-reveal="160">
        <p class="section-lead" id="mapLead">어디로 들어가 볼까요?</p>
        <div class="continents" id="continents">
          {domains.map((d, i) => {
            const c = counts(d);
            return (
              <button class="cont" type="button" data-key={d.key} style={`--dc:${d.color}; --i:${i}`} aria-label={`${d.title} 대륙 열기`}>
                <span class="cont-glow" aria-hidden="true"></span>
                <span class="cont-sheen" aria-hidden="true"></span>
                <span class="cont-face" aria-hidden="true">
                  <span class="cf-body"><span class="cf-eye l"></span><span class="cf-eye r"></span><span class="cf-cheek l"></span><span class="cf-cheek r"></span></span>
                  <span class="cf-badge">{d.icon}</span>
                </span>
                <span class="cont-num">대륙 {d.key}</span>
                <span class="cont-title">{d.title}</span>
                <span class="cont-en">{d.en} · {d.tagline}</span>
                <span class="cont-meta">
                  <span class="cm"><i class="dot live"></i>{c.live} 작동</span>
                  <span class="cm"><i class="dot building"></i>{c.building} 제작</span>
                  <span class="cm">{c.branches}지역 · {c.total}곳</span>
                </span>
                <span class="cont-enter">들어가기 →</span>
              </button>
            );
          })}
        </div>

        {domains.map((d) => (
            <section class="detail" id={`d-${d.key}`} data-key={d.key} style={`--dc:${d.color}`} hidden>
              <div class="detail-bar">
                <button class="back" type="button" data-back>← 전체 지도</button>
                <div class="crumb"><span>거울 지도</span> <b>/</b> <span class="cr-here">{d.icon} {d.title}</span></div>
                <div class="dfilter" role="group" aria-label="상태 필터">
                  <button class="fchip on" data-status="all" type="button">전체</button>
                  <button class="fchip" data-status="live" type="button"><i class="dot live"></i>작동</button>
                  <button class="fchip" data-status="building" type="button"><i class="dot building"></i>제작</button>
                  <button class="fchip" data-status="idea" type="button"><i class="dot idea"></i>아이디어</button>
                </div>
              </div>
              <div class="detail-head">
                <span class="dh-face" aria-hidden="true">
                  <span class="cf-body"><span class="cf-eye l"></span><span class="cf-eye r"></span><span class="cf-cheek l"></span><span class="cf-cheek r"></span></span>
                  <span class="cf-badge">{d.icon}</span>
                </span>
                <div><h2>{d.title} <span class="dh-en">{d.en}</span></h2><p>{d.tagline}</p></div>
              </div>
              <div class="regions">
                {d.branches.map((b) => (
                  <div class="region">
                    <h3>{b.h}</h3>
                    <ul>
                      {b.items.map((it) => {
                        const m = statusMeta(it.status);
                        return (
                          <li class="place" data-status={it.status}>
                            <a class="place-a" href={hrefOf(it)}>
                              <span class={`dot ${m.cls}`} title={m.label}></span>
                              <span class="place-t">{it.t}</span>
                              {it.from && <span class="from">{it.from}</span>}
                              {it.to && <span class="ext" title="바로 기능 페이지">↗</span>}
                              <span class="go">→</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
              <p class="no-hit" hidden>이 상태에 해당하는 장소가 없어요.</p>
            </section>
        ))}
      </div>

      <div class="legend">
        <span><i class="dot live"></i>작동 중</span>
        <span><i class="dot building"></i>만드는 중</span>
        <span><i class="dot seed"></i>내용 있음</span>
        <span><i class="dot idea"></i>아이디어</span>
        <span class="legend-note">· 던진 건 알아서 제자리에 쌓이고, 밤마다 다시 엮여요.</span>
      </div>
    </div>
  </section>

  <!-- ═══════════ The Loop ═══════════ -->
  <section class="loop-sec">
    <div class="wrap">
      <p class="section-kicker" data-reveal>The Loop</p>
      <h2 data-reveal="60">생각 → 지식 → 자산</h2>
      <p class="lead" data-reveal="120">던지면 알아서 엮이고 서술된다. 네 단계가 서로 다른 리듬으로 돈다.</p>
      <div class="num-grid">
        <div class="num-item" data-reveal="0"><span class="ni">01</span><h4>던진다</h4><p>떠오른 생각을 그대로 던진다. 정리·분류·태그는 없다. 입력 마찰 0.</p></div>
        <div class="num-item" data-reveal="80"><span class="ni">02</span><h4>엮인다</h4><p>쌓인 메모 사이의 연결을 매일 밤 자동으로 발견한다. 오늘 생각이 지난달·외부 개념과 이어진다.</p></div>
        <div class="num-item" data-reveal="160"><span class="ni">03</span><h4>자산이 된다</h4><p>성숙한 생각은 글·발표·아카이브가 된다. 생각의 과정 자체가 포트폴리오.</p></div>
        <div class="num-item" data-reveal="240"><span class="ni">04</span><h4>소유권은 나에게</h4><p>AI는 편집자일 뿐. 내 생각은 내 언어로, 내 자산으로 남는다.</p></div>
      </div>
    </div>
  </section>

  <!-- ═══════════ Build Logs ═══════════ -->
  <section>
    <div class="wrap">
      <p class="section-kicker" data-reveal>Build Logs</p>
      <h2 data-reveal="60">이 시스템을 만들어가는 기록</h2>
      <p class="lead" data-reveal="120">Aramirror가 어떻게 태어나고 자라는지, 개발일지로 남긴다.</p>
      <ul class="logs" data-reveal="160">
        {latestLogs.map((l) => (
          <li><a href={l.href}><span class="id">{l.id}</span><span class="t">{l.title}</span><span class="d">{l.date}</span></a></li>
        ))}
      </ul>
      <p data-reveal="200" style="margin-top:22px"><a class="btn-outline" href="/build-logs">전체 기록 보기 →</a></p>
    </div>
  </section>

  <style is:global>
    /* ══════════ 히어로 ══════════ */
    .ghero { position: relative; overflow: hidden; padding: clamp(30px, 6vw, 64px) 0 clamp(30px, 6vw, 56px); }
    .gh-orb { position: absolute; border-radius: 50%; filter: blur(46px); opacity: .5; pointer-events: none; z-index: 0; }
    .gh-orb.o1 { width: 340px; height: 340px; top: -110px; right: -60px; background: radial-gradient(circle, #ffb45766, transparent 70%); animation: drift 14s var(--ease) infinite; }
    .gh-orb.o2 { width: 300px; height: 300px; bottom: -120px; left: -70px; background: radial-gradient(circle, #ff5d8f4d, transparent 70%); animation: drift 18s var(--ease) infinite reverse; }
    .gh-wrap { position: relative; z-index: 1; display: grid; grid-template-columns: 1.35fr 1fr; align-items: center; gap: 30px; }
    .gh-kicker { font-family: var(--mono); font-size: .78rem; letter-spacing: .04em; color: var(--accent); margin-bottom: 12px; }
    .gh-title { font-size: clamp(1.85rem, 5vw, 2.95rem); line-height: 1.13; letter-spacing: -.03em; font-weight: 800; }
    .gh-title mark { background: var(--grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; padding: 0; }
    .gh-title .wave { display: inline-block; transform-origin: 70% 80%; animation: wave 2.4s var(--ease) infinite; }
    .gh-sub { margin-top: 14px; max-width: 44ch; color: var(--fg-soft); font-size: 1.02rem; line-height: 1.6; }

    /* 성장 컴패니언 */
    .grow { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; margin-top: 22px; padding: 15px 18px; border-radius: 20px; background: var(--bg-1); border: 1px solid var(--line); box-shadow: var(--shadow-soft); max-width: 520px; }
    .grow-ring { position: relative; width: 60px; height: 60px; flex-shrink: 0; }
    .grow-ring svg { width: 60px; height: 60px; transform: rotate(-90deg); }
    .gr-bg { fill: none; stroke: color-mix(in srgb, var(--accent) 14%, var(--bg-2)); stroke-width: 6; }
    .gr-fg { fill: none; stroke: url(#g); stroke: var(--accent); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 195; stroke-dashoffset: 184; transition: stroke-dashoffset 1s var(--ease); filter: drop-shadow(0 0 4px var(--accent-glow)); }
    .gr-n { position: absolute; inset: 0; display: grid; place-items: center; line-height: 1; }
    .gr-n b { font-size: 1.15rem; font-weight: 800; color: var(--accent); }
    .gr-n small { font-size: .55rem; color: var(--muted); font-family: var(--mono); }
    .grow-mid { min-width: 0; }
    .gchips { display: flex; flex-wrap: wrap; gap: 6px; }
    .gchip { display: inline-flex; align-items: baseline; gap: 4px; background: var(--bg-2); border: 1px solid var(--line); border-radius: 999px; padding: 3px 9px; font-size: .7rem; color: var(--fg-soft); }
    .gchip b { font-size: .84rem; font-weight: 800; color: var(--fg); font-variant-numeric: tabular-nums; }
    .gchip.live b { color: #128a7c; }
    .gxp { height: 9px; margin: 9px 0 5px; border-radius: 999px; background: color-mix(in srgb, var(--accent) 12%, var(--bg-2)); overflow: hidden; }
    .gxp i { display: block; height: 100%; border-radius: 999px; background: var(--grad); box-shadow: 0 0 10px var(--accent-glow); transition: width 1s var(--ease); }
    .gxp-line { font-family: var(--mono); font-size: .68rem; color: var(--muted); }
    .sprout { width: 62px; height: 62px; flex-shrink: 0; animation: bob 3.4s var(--ease) infinite; }
    .sprout svg { width: 100%; height: 100%; overflow: visible; }
    .sprout .gg { opacity: 0; transform-origin: 45px 66px; transform: scale(.4); transition: opacity .5s, transform .5s var(--ease); }
    .sprout .seed { transition: opacity .4s; }
    .sprout[data-stage="0"] .seed { opacity: 1; } .sprout:not([data-stage="0"]) .seed { opacity: 0; }
    .sprout[data-stage="1"] .g1, .sprout[data-stage="2"] .g1, .sprout[data-stage="2"] .g2,
    .sprout[data-stage="3"] .g1, .sprout[data-stage="3"] .g2, .sprout[data-stage="3"] .g3,
    .sprout[data-stage="4"] .g1, .sprout[data-stage="4"] .g2, .sprout[data-stage="4"] .g3, .sprout[data-stage="4"] .g4,
    .sprout[data-stage="5"] .g5 { opacity: 1; transform: scale(1); }

    /* 아라미 캐릭터 */
    .gh-char { display: grid; place-items: center; }
    .arami { position: relative; width: 190px; height: 190px; animation: float 4s var(--ease) infinite; }
    .ar-shadow { position: absolute; bottom: 2px; left: 50%; transform: translateX(-50%); width: 108px; height: 20px; border-radius: 50%; background: radial-gradient(ellipse, rgba(70,45,25,.22), transparent 72%); animation: shadowpulse 4s var(--ease) infinite; }
    .ar-ring { position: absolute; inset: 6px; border-radius: 50%; border: 2px dashed color-mix(in srgb, var(--accent) 45%, transparent); animation: spin 22s linear infinite; }
    .ar-body { position: absolute; inset: 20px; border-radius: 50% 50% 48% 48%; background: linear-gradient(160deg, #fff 0%, #ffe6d3 44%, #ffb9a0 100%); box-shadow: inset 0 -14px 26px rgba(255,120,90,.35), inset 0 10px 20px #fff, 0 18px 36px rgba(242,98,47,.30); animation: squish 3.2s var(--ease) infinite; }
    .ar-shine { position: absolute; top: 16%; left: 20%; width: 34%; height: 24%; border-radius: 50%; background: radial-gradient(circle at 40% 40%, rgba(255,255,255,.95), transparent 68%); }
    .ar-eye { position: absolute; top: 44%; width: 15px; height: 20px; background: #3a2418; border-radius: 50%; animation: blink 4s infinite; }
    .ar-eye::after { content: ""; position: absolute; top: 3px; left: 3px; width: 5px; height: 5px; background: #fff; border-radius: 50%; }
    .ar-eye.l { left: 34%; } .ar-eye.r { right: 34%; }
    .ar-cheek { position: absolute; top: 55%; width: 16px; height: 10px; border-radius: 50%; background: #ff9a8b; opacity: .6; filter: blur(1px); }
    .ar-cheek.l { left: 27%; } .ar-cheek.r { right: 27%; }
    .ar-mouth { position: absolute; top: 60%; left: 50%; transform: translateX(-50%); width: 26px; height: 13px; border: 3px solid #3a2418; border-top: 0; border-radius: 0 0 26px 26px; animation: talk 4s var(--ease) infinite; }
    .ar-hand { position: absolute; right: 6%; top: 38%; font-size: 30px; transform-origin: 60% 90%; animation: wave 2s var(--ease) infinite; }
    .ar-spark { position: absolute; font-size: 18px; color: var(--a2); animation: twinkle 2.4s ease-in-out infinite; }
    .ar-spark.s1 { top: 8%; right: 6%; } .ar-spark.s2 { bottom: 20%; left: 0%; color: var(--a3); animation-delay: .7s; font-size: 15px; } .ar-spark.s3 { top: 30%; left: -6%; color: var(--a1); animation-delay: 1.3s; font-size: 13px; }
    .ar-say { margin-top: 8px; font-size: .9rem; font-weight: 700; color: var(--accent); background: var(--bg-1); border: 1px solid var(--line); padding: 7px 14px; border-radius: 999px; box-shadow: var(--shadow-soft); animation: pop 3.4s var(--ease) infinite; }

    /* ══════════ 캐릭터 런처 ══════════ */
    .applaunch { padding-top: 6px; }
    .crit-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 14px; margin-top: 22px; }
    .critc { position: relative; overflow: hidden; text-decoration: none; color: var(--fg); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 3px; padding: 18px 12px 15px; border-radius: 22px; background: linear-gradient(165deg, color-mix(in srgb, var(--ac) 12%, var(--bg-1)), var(--bg-1) 76%); border: 1px solid color-mix(in srgb, var(--ac) 26%, var(--line)); box-shadow: var(--shadow-soft); transition: transform .18s var(--ease), box-shadow .2s, border-color .2s; animation: rise .5s var(--ease) both; animation-delay: var(--d); }
    .critc:hover { transform: translateY(-6px); border-color: var(--ac); box-shadow: 0 20px 40px color-mix(in srgb, var(--ac) 30%, transparent); }
    .critc:active { transform: translateY(-1px) scale(.96); }

    .crit { position: relative; width: 66px; height: 62px; margin-bottom: 8px; }
    .crit-shadow { position: absolute; bottom: -2px; left: 50%; transform: translateX(-50%); width: 42px; height: 8px; border-radius: 50%; background: radial-gradient(ellipse, rgba(70,45,25,.20), transparent 72%); }
    .crit-body { position: absolute; inset: 0 6px 4px 6px; border-radius: 50% 50% 46% 46%; background: linear-gradient(160deg, color-mix(in srgb, var(--ac) 45%, #fff), color-mix(in srgb, var(--ac) 92%, #000 8%)); box-shadow: inset 0 -6px 12px rgba(0,0,0,.22), inset 0 6px 10px rgba(255,255,255,.5), 0 8px 16px color-mix(in srgb, var(--ac) 35%, transparent); }
    .crit-eye { position: absolute; top: 34%; width: 9px; height: 13px; background: #241a14; border-radius: 50%; animation: blink 3.6s infinite; }
    .crit-eye::after { content: ""; position: absolute; top: 2px; left: 2px; width: 3.5px; height: 3.5px; background: #fff; border-radius: 50%; }
    .crit-eye.l { left: 30%; } .crit-eye.r { right: 30%; }
    .crit-cheek { position: absolute; top: 50%; width: 10px; height: 6px; border-radius: 50%; background: #ff8f7d; opacity: .55; filter: blur(.5px); }
    .crit-cheek.l { left: 20%; } .crit-cheek.r { right: 20%; }
    .crit-badge { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); font-size: 1.05rem; line-height: 1; filter: drop-shadow(0 1px 1px rgba(0,0,0,.25)); }
    .crit-label { font-weight: 800; font-size: .98rem; letter-spacing: -.02em; }
    .crit-sub { font-size: .72rem; color: var(--muted); }

    /* 꼬마들 각자 다른 리듬 (살아있게) */
    .m-hop  .crit-body { animation: hop 1.9s var(--ease) infinite; animation-delay: var(--d); }
    .m-bob  .crit-body { animation: bob 2.6s var(--ease) infinite; animation-delay: var(--d); }
    .m-sway .crit-body { animation: sway 2.8s var(--ease) infinite; animation-delay: var(--d); transform-origin: 50% 90%; }
    .m-spin .crit-body { animation: wobble 3s var(--ease) infinite; animation-delay: var(--d); transform-origin: 50% 90%; }
    .critc:hover .crit-body { animation: cheer .5s var(--ease) infinite; }
    .critc:hover .crit-badge { animation: pop .5s var(--ease) infinite; }

    /* ══════════ 대륙 캐릭터 타일 ══════════ */
    .conts-sec { padding-top: 8px; }
    .conts { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; margin-top: 22px; }
    .ctile { position: relative; overflow: hidden; text-decoration: none; color: var(--fg); display: flex; flex-direction: column; gap: 3px; padding: 20px; border-radius: 22px; background: linear-gradient(158deg, color-mix(in srgb, var(--dc) 15%, var(--bg-1)), var(--bg-1) 74%); border: 1px solid color-mix(in srgb, var(--dc) 30%, var(--line)); box-shadow: var(--shadow-soft); transition: transform .2s var(--ease), border-color .2s, box-shadow .2s; animation: rise .5s var(--ease) both; animation-delay: var(--d); }
    .ctile:hover { transform: translateY(-5px); border-color: var(--dc); box-shadow: 0 20px 42px color-mix(in srgb, var(--dc) 30%, transparent); }
    .ct-glow { position: absolute; top: -40px; right: -40px; width: 130px; height: 130px; background: radial-gradient(circle, color-mix(in srgb, var(--dc) 50%, transparent), transparent 70%); opacity: .5; pointer-events: none; transition: opacity .2s; }
    .ctile:hover .ct-glow { opacity: .95; }
    .ct-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .ct-ring { position: relative; width: 60px; height: 60px; display: grid; place-items: center; }
    .ct-ring svg { position: absolute; inset: 0; transform: rotate(-90deg); }
    .ct-track { fill: none; stroke: color-mix(in srgb, var(--dc) 18%, var(--line)); stroke-width: 5; }
    .ct-fill { fill: none; stroke: var(--dc); stroke-width: 5; stroke-linecap: round; transition: stroke-dasharray 1s var(--ease); filter: drop-shadow(0 0 4px color-mix(in srgb, var(--dc) 60%, transparent)); }
    /* 대륙 친구 얼굴 */
    .ct-face { position: relative; width: 40px; height: 38px; border-radius: 50% 50% 46% 46%; background: linear-gradient(160deg, color-mix(in srgb, var(--dc) 50%, #fff), color-mix(in srgb, var(--dc) 92%, #000 8%)); box-shadow: inset 0 -4px 8px rgba(0,0,0,.2), inset 0 4px 7px rgba(255,255,255,.5); animation: bob 3s var(--ease) infinite; }
    .ctile:hover .ct-face { animation: cheer .5s var(--ease) infinite; }
    .ct-eye { position: absolute; top: 32%; width: 6px; height: 9px; background: #241a14; border-radius: 50%; animation: blink 4.2s infinite; }
    .ct-eye::after { content: ""; position: absolute; top: 1.5px; left: 1.5px; width: 2.5px; height: 2.5px; background: #fff; border-radius: 50%; }
    .ct-eye.l { left: 28%; } .ct-eye.r { right: 28%; }
    .ct-cheek { position: absolute; top: 50%; width: 7px; height: 4px; border-radius: 50%; background: #ff8f7d; opacity: .5; }
    .ct-cheek.l { left: 16%; } .ct-cheek.r { right: 16%; }
    .ct-emoji { position: absolute; bottom: 1px; left: 50%; transform: translateX(-50%); font-size: .8rem; line-height: 1; }
    .ct-pct { font-family: var(--mono); font-weight: 800; font-size: 1.5rem; color: var(--dc); font-variant-numeric: tabular-nums; }
    .ct-pct small { font-size: .8rem; opacity: .7; }
    .ct-num { font-family: var(--mono); font-size: .66rem; color: var(--dc); letter-spacing: .05em; text-transform: uppercase; }
    .ct-title { font-size: 1.22rem; font-weight: 800; letter-spacing: -.02em; line-height: 1.12; }
    .ct-tag { font-size: .82rem; color: var(--fg-soft); }
    .ct-foot { display: flex; align-items: center; gap: 7px; margin-top: 13px; padding-top: 11px; border-top: 1px solid var(--line-soft); font-family: var(--mono); font-size: .72rem; color: var(--muted); font-variant-numeric: tabular-nums; }
    .ct-foot .dot { width: 7px; height: 7px; border-radius: 50%; background: #34d3c0; box-shadow: 0 0 7px #34d3c0; animation: pulse 2s infinite; }
    .ct-go { margin-left: auto; color: var(--dc); font-weight: 700; }

    /* ══════════ 애니메이션 ══════════ */
    @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
    @keyframes squish { 0%,100% { border-radius: 50% 50% 48% 48%; } 50% { border-radius: 48% 48% 52% 52%; } }
    @keyframes shadowpulse { 0%,100% { transform: translateX(-50%) scale(1); opacity: .22; } 50% { transform: translateX(-50%) scale(.8); opacity: .12; } }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes blink { 0%,92%,100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
    @keyframes talk { 0%,100% { height: 13px; } 50% { height: 8px; } }
    @keyframes wave { 0%,100% { transform: rotate(0); } 25% { transform: rotate(-22deg); } 60% { transform: rotate(14deg); } }
    @keyframes twinkle { 0%,100% { opacity: .25; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.15); } }
    @keyframes pop { 0%,100% { transform: translateX(-50%) scale(1); } 50% { transform: translateX(-50%) scale(1.08); } }
    @keyframes fillin { from { width: 0; } }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
    @keyframes hop { 0%,100% { transform: translateY(0) scaleY(1); } 15% { transform: translateY(0) scaleY(.86); } 45% { transform: translateY(-14px) scaleY(1.06); } 75% { transform: translateY(0) scaleY(.94); } }
    @keyframes sway { 0%,100% { transform: rotate(-7deg); } 50% { transform: rotate(7deg); } }
    @keyframes wobble { 0%,100% { transform: rotate(0); } 25% { transform: rotate(-9deg); } 75% { transform: rotate(9deg); } }
    @keyframes cheer { 0%,100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-9px) rotate(4deg); } }
    @keyframes drift { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-24px, 20px); } }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }

    @media (max-width: 820px) {
      .gh-wrap { grid-template-columns: 1fr; text-align: center; }
      .gh-sub, .grow { margin-left: auto; margin-right: auto; }
      .gh-char { order: -1; }
      .arami { width: 150px; height: 150px; }
      .grow { grid-template-columns: auto 1fr; }
      .grow .sprout { grid-column: 1 / 3; justify-self: center; }
      .gchips { justify-content: center; }
    }
    @media (prefers-reduced-motion: reduce) {
      .arami, .ar-ring, .ar-eye, .ar-mouth, .ar-spark, .ar-shadow, .ar-hand, .ar-body, .wave,
      .critc, .crit-body, .crit-badge, .ct-face, .ct-eye, .ct-foot .dot, .sprout, .gh-orb { animation: none !important; }
    }

    /* ══════════ 거울 지도 (병합) ══════════ */
    .map-sec .section-lead { font-size: 1.02rem; font-weight: 600; color: var(--fg-soft); margin: 18px 2px 16px; }
    .continents { display: grid; grid-template-columns: repeat(auto-fill, minmax(324px, 1fr)); gap: 16px; }
    .cont {
      position: relative; text-align: left; cursor: pointer; overflow: hidden; isolation: isolate;
      display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto auto auto; gap: 3px 16px;
      padding: 24px; border-radius: 24px; color: var(--fg);
      background: linear-gradient(155deg, color-mix(in srgb, var(--dc) 16%, var(--bg-1)), var(--bg-1) 74%);
      border: 1px solid color-mix(in srgb, var(--dc) 32%, var(--line));
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
      transition: transform .24s var(--ease), box-shadow .24s var(--ease), border-color .24s;
      animation: rise .5s var(--ease) both; animation-delay: calc(var(--i) * .06s);
    }
    .cont:hover, .cont:focus-visible { transform: translateY(-6px); border-color: var(--dc); box-shadow: 0 26px 56px rgba(0,0,0,.5), 0 0 0 1px color-mix(in srgb, var(--dc) 40%, transparent); outline: none; }
    .cont:focus-visible { box-shadow: 0 0 0 2px var(--dc), 0 26px 56px rgba(0,0,0,.5); }
    .cont-glow { position: absolute; top: -50px; right: -50px; width: 180px; height: 180px; background: radial-gradient(circle, color-mix(in srgb, var(--dc) 50%, transparent), transparent 68%); opacity: .55; pointer-events: none; z-index: -1; transition: opacity .24s, transform .24s; }
    .cont:hover .cont-glow { opacity: .95; transform: scale(1.12); }
    .cont-sheen { position: absolute; inset: 0; background: linear-gradient(120deg, transparent 40%, rgba(255,255,255,.06) 50%, transparent 60%); transform: translateX(-120%); transition: transform .6s var(--ease); pointer-events: none; z-index: -1; }
    .cont:hover .cont-sheen { transform: translateX(120%); }
    .cont-face, .dh-face { position: relative; width: 62px; height: 58px; grid-row: 1 / 4; }
    .dh-face { grid-row: auto; flex: 0 0 auto; }
    .cf-body { position: absolute; inset: 0; border-radius: 50% 50% 46% 46%; background: linear-gradient(160deg, color-mix(in srgb, var(--dc) 92%, #fff 8%), color-mix(in srgb, var(--dc) 62%, #000 38%)); box-shadow: inset 0 -8px 12px rgba(0,0,0,.28), 0 8px 18px rgba(0,0,0,.42); animation: bob 3s var(--ease) infinite; }
    .cont:hover .cf-body { animation-duration: 1.1s; }
    .cf-eye { position: absolute; top: 25px; width: 8px; height: 11px; background: #1a1620; border-radius: 50%; animation: blink 5s infinite; }
    .cf-eye::after { content: ""; position: absolute; top: 1px; left: 1.5px; width: 3px; height: 3px; background: #fff; border-radius: 50%; }
    .cf-eye.l { left: 18px; } .cf-eye.r { right: 18px; }
    .cf-cheek { position: absolute; top: 34px; width: 7px; height: 4px; background: rgba(255,120,120,.5); border-radius: 50%; }
    .cf-cheek.l { left: 12px; } .cf-cheek.r { right: 12px; }
    .cf-badge { position: absolute; top: -6px; right: -8px; width: 27px; height: 27px; font-size: 1.02rem; background: var(--bg); border: 1px solid var(--line); border-radius: 50%; display: grid; place-items: center; box-shadow: 0 3px 9px rgba(0,0,0,.5); }
    .cont-num { grid-column: 2; font-family: var(--mono); font-size: .7rem; color: var(--dc); letter-spacing: .07em; text-transform: uppercase; }
    .cont-title { grid-column: 2; font-size: 1.45rem; font-weight: 800; letter-spacing: -.02em; line-height: 1.08; }
    .cont-en { grid-column: 2; font-size: .82rem; color: var(--fg-soft); }
    .cont-meta { grid-column: 1 / 3; display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 14px; padding-top: 13px; border-top: 1px solid var(--line-soft); }
    .cm { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: .72rem; color: var(--muted); font-variant-numeric: tabular-nums; }
    .cont-enter { position: absolute; right: 22px; bottom: 22px; font-size: .84rem; font-weight: 700; color: var(--dc); opacity: 0; transform: translateX(-6px); transition: opacity .22s, transform .22s; }
    .cont:hover .cont-enter, .cont:focus-visible .cont-enter { opacity: 1; transform: none; }

    .view[data-level="overview"] .detail { display: none; }
    .view[data-level="detail"] .continents, .view[data-level="detail"] #mapLead { display: none; }
    .detail { padding: 0; margin: 0; animation: drillIn .32s var(--ease); }
    @keyframes drillIn { from { opacity: 0; transform: scale(.97) translateY(8px); } }

    .detail-bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
    .back { background: var(--bg-2); border: 1px solid var(--line); color: var(--fg); font: inherit; font-size: .86rem; font-weight: 600; padding: 9px 15px; border-radius: 999px; cursor: pointer; transition: border-color .15s, background .15s; }
    .back:hover { border-color: var(--dc); background: color-mix(in srgb, var(--dc) 12%, var(--bg-2)); }
    .crumb { font-size: .84rem; color: var(--muted); }
    .crumb b { color: var(--faint); margin: 0 2px; }
    .crumb .cr-here { color: var(--fg); font-weight: 600; }
    .dfilter { display: flex; gap: 6px; margin-left: auto; flex-wrap: wrap; }
    .fchip { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg-2); color: var(--fg-soft); font-size: .8rem; font-weight: 600; cursor: pointer; transition: background .14s, color .14s, border-color .14s; }
    .fchip:hover { color: var(--fg); }
    .fchip.on { background: color-mix(in srgb, var(--dc) 20%, transparent); border-color: var(--dc); color: #fff; }
    .detail-head { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; padding: 22px; border-radius: 22px; background: linear-gradient(155deg, color-mix(in srgb, var(--dc) 15%, var(--bg-1)), var(--bg-1) 70%); border: 1px solid color-mix(in srgb, var(--dc) 28%, var(--line)); }
    .detail-head h2 { margin: 0; font-size: 1.6rem; letter-spacing: -.02em; }
    .dh-en { font-size: .82rem; color: var(--muted); font-weight: 500; margin-left: 8px; }
    .detail-head p { margin: 4px 0 0; color: var(--fg-soft); font-size: .9rem; }
    .regions { columns: 320px 3; column-gap: 16px; }
    .region { break-inside: avoid; margin: 0 0 16px; padding: 18px; border-radius: 18px; background: var(--bg-1); border: 1px solid var(--line); }
    .region h3 { margin: 0 0 10px; font-size: 1rem; font-weight: 700; letter-spacing: -.01em; display: flex; align-items: center; gap: 8px; }
    .region h3::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--dc); box-shadow: 0 0 7px var(--dc); }
    .region ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
    .place-a { display: flex; align-items: center; gap: 10px; padding: 9px 10px; margin: 0 -6px; border-radius: 10px; color: var(--fg-soft); font-size: .92rem; text-decoration: none; transition: background .14s, color .14s; }
    .place-a:hover, .place-a:focus-visible { background: color-mix(in srgb, var(--dc) 12%, var(--bg-2)); color: var(--fg); outline: none; }
    .place-t { flex: 1; line-height: 1.35; }
    .from { font-size: .7rem; color: var(--muted); background: var(--bg-2); border: 1px solid var(--line-soft); padding: 2px 7px; border-radius: 999px; white-space: nowrap; }
    .ext { color: var(--muted); font-size: .78rem; }
    .go { color: var(--dc); font-size: .85rem; opacity: 0; transform: translateX(-4px); transition: opacity .14s, transform .14s; }
    .place-a:hover .go { opacity: 1; transform: none; }
    .place[hidden] { display: none; }
    .no-hit { text-align: center; color: var(--muted); padding: 30px; }

    .dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; background: var(--line); box-shadow: 0 0 6px currentColor; }
    .dot.live { background: #6fe08a; color: #6fe08a; }
    .dot.building { background: #ffc061; color: #ffc061; }
    .dot.seed { background: #a78bfa; color: #a78bfa; }
    .dot.idea { background: #6b6f7a; color: transparent; }

    .legend { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin: 32px 2px 0; color: var(--muted); font-size: .84rem; }
    .legend > span { display: inline-flex; align-items: center; gap: 7px; }
    .legend-note { color: var(--faint); }
    @media (max-width: 620px) { .continents { grid-template-columns: 1fr; } .regions { columns: 1; } .dfilter { margin-left: 0; width: 100%; } }
    /* ══════════════ 아라미 데크 ══════════════ */
    .deck { position: relative; overflow: hidden; padding: clamp(26px, 4.4vw, 52px) 0 clamp(30px, 5vw, 56px); }
    .deck-wrap { position: relative; z-index: 1; display: flex; flex-direction: column; gap: clamp(14px, 2vw, 20px); }

    .dk-top { display: grid; grid-template-columns: 1fr auto; gap: 26px; align-items: center; }
    .dk-kicker { font-family: var(--mono); font-size: .74rem; letter-spacing: .12em; color: var(--muted); margin: 0 0 10px; }
    .dk-title { font-size: clamp(1.7rem, 4vw, 2.9rem); line-height: 1.12; letter-spacing: -.042em; font-weight: 800; margin: 0 0 10px; }
    .dk-title mark { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .dk-say { margin: 0; color: var(--fg-soft); font-size: clamp(.94rem, 1.5vw, 1.06rem); line-height: 1.6; }

    /* 레벨 링 */
    .dk-level { display: flex; align-items: center; gap: 18px; }
    .dk-ring { position: relative; width: clamp(96px, 11vw, 124px); aspect-ratio: 1; flex: none; }
    .dk-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .rk-bg { fill: none; stroke: var(--line); stroke-width: 8; }
    .rk-fg {
      fill: none; stroke: url(#dkGrad); stroke: var(--accent); stroke-width: 8; stroke-linecap: round;
      stroke-dasharray: 326.7; stroke-dashoffset: 313; transition: stroke-dashoffset 1.1s var(--ease);
      filter: drop-shadow(0 0 6px var(--accent-glow));
    }
    .rk-mid { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; line-height: 1.15; }
    .rk-ic { font-size: clamp(1.3rem, 2vw, 1.7rem); display: block; }
    .rk-lv { font-family: var(--mono); font-size: .72rem; color: var(--muted); font-weight: 600; display: block; margin-top: 2px; }
    .rk-name { font-style: normal; font-weight: 800; font-size: .92rem; letter-spacing: -.02em; display: block;
      background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .dk-lvinfo { min-width: min(240px, 42vw); }
    .dk-xpbar { height: 8px; border-radius: 999px; background: var(--bg-soft); overflow: hidden; border: 1px solid var(--line-soft); }
    .dk-xpbar i { display: block; height: 100%; background: var(--grad); border-radius: 999px; transition: width 1s var(--ease); }
    .dk-xptext { margin: 7px 0 10px; font-size: .78rem; color: var(--muted); }
    .dk-xptext b { color: var(--fg); font-family: var(--mono); }
    .dk-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .dk-chip { display: inline-flex; align-items: baseline; gap: 5px; background: var(--bg-1); border: 1px solid var(--line);
      border-radius: 999px; padding: 5px 11px; font-size: .74rem; color: var(--muted); }
    .dk-chip b { font-family: var(--mono); font-weight: 700; color: var(--fg); font-size: .86rem; }
    .dk-chip i { font-style: normal; }

    /* 한 줄 입력 — 주인공 */
    .dk-cap { position: relative; display: flex; align-items: center; gap: 10px;
      background: var(--bg-1); border: 2px solid var(--line); border-radius: 999px;
      padding: 8px 8px 8px 20px; box-shadow: 0 10px 30px rgba(196,110,54,.10);
      transition: border-color .25s var(--ease), box-shadow .25s var(--ease), transform .25s var(--ease); }
    .dk-cap:focus-within { border-color: var(--accent); box-shadow: 0 16px 44px var(--accent-glow); transform: translateY(-2px); }
    .dk-cap-ic { font-size: 1.15rem; flex: none; }
    .dk-cap input { flex: 1; min-width: 0; border: 0; background: none; font-family: inherit;
      font-size: clamp(.95rem, 1.6vw, 1.08rem); color: var(--fg); padding: 10px 0; }
    .dk-cap input:focus { outline: none; }
    .dk-cap input::placeholder { color: var(--faint); }
    .dk-cap-btn { flex: none; border: 0; cursor: pointer; font-family: inherit; font-weight: 800; font-size: .92rem;
      border-radius: 999px; padding: 12px 24px; background: var(--grad); color: #fff;
      box-shadow: 0 8px 20px var(--accent-glow); transition: transform .2s var(--ease); }
    .dk-cap-btn:hover { transform: translateY(-2px) scale(1.03); }
    .dk-cap-btn:active { transform: scale(.97); }
    .dk-route { position: absolute; left: 20px; right: 20px; top: calc(100% + 8px); z-index: 3;
      background: var(--bg-1); border: 1px dashed var(--accent); border-radius: 14px; padding: 10px 14px;
      font-size: .82rem; color: var(--fg-soft); box-shadow: var(--shadow-soft); }
    .dk-route b { color: var(--accent-strong); }

    /* 카드 공통 */
    .dk-grid { display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 12px; }
    .dk-grid2 { display: grid; grid-template-columns: 1fr 1.15fr; gap: 12px; }
    .dk-grid2.one { grid-template-columns: 1fr; }
    .dk-card { background: var(--bg-1); border: 1px solid var(--line); border-radius: 18px; padding: 16px 18px 15px; }
    .dk-h { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; font-size: .88rem; font-weight: 800; letter-spacing: -.02em; }
    .dk-h-n { font-family: var(--mono); font-size: .74rem; color: var(--accent); font-weight: 700; }
    .dk-h-go { margin-left: auto; font-size: .74rem; font-weight: 700; color: var(--accent); background: none; border: 0;
      cursor: pointer; font-family: inherit; padding: 0; }

    /* 오늘의 미션 */
    .miss-list { list-style: none; margin: 0 0 11px; padding: 0; display: flex; flex-direction: column; gap: 7px; }
    .miss { display: flex; align-items: center; gap: 9px; font-size: .86rem; color: var(--fg-soft); }
    .miss .mk { width: 19px; height: 19px; border-radius: 6px; border: 1.5px solid var(--line); flex: none;
      display: grid; place-items: center; font-size: .66rem; color: transparent; transition: .28s var(--ease); }
    .miss.on .mk { background: #3fbf76; border-color: #3fbf76; color: #fff; transform: scale(1.06); }
    .miss.on .mt { color: var(--muted); text-decoration: line-through; }
    .miss .mi { font-size: .95rem; }
    .miss .mt { font-weight: 600; color: var(--fg); }
    .miss .mh { margin-left: auto; font-size: .68rem; color: var(--faint); white-space: nowrap; }
    .miss-bar { height: 6px; border-radius: 999px; background: var(--bg-soft); overflow: hidden; }
    .miss-bar i { display: block; height: 100%; background: linear-gradient(90deg,#3fbf76,#7fd67a); transition: width .6s var(--ease); }

    /* 파이프라인 */
    .pflow { display: flex; align-items: stretch; gap: 4px; }
    .pf { flex: 1; text-align: center; text-decoration: none; border-radius: 12px; padding: 10px 4px 8px;
      background: var(--bg-2); border: 1px solid var(--line); transition: .25s var(--ease); }
    .pf:hover { border-color: var(--accent); transform: translateY(-3px); }
    .pf b { display: block; font-family: var(--mono); font-size: 1.25rem; font-weight: 700; color: var(--fg); line-height: 1.1; }
    .pf span { display: block; font-size: .66rem; color: var(--muted); margin-top: 2px; }
    .pf-goal { background: linear-gradient(180deg, rgba(52,211,192,.16), var(--bg-2)); border-color: rgba(52,211,192,.45); }
    .pf-goal b { color: #1f9e8c; }
    .pf-arrow { position: relative; width: 16px; flex: none; align-self: center; height: 2px; background: var(--line); border-radius: 2px; }
    .pf-arrow em { position: absolute; top: -2px; left: 0; width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); animation: pfRun 2.4s var(--ease) infinite; }
    .pf-arrow:nth-of-type(2) em { animation-delay: .35s; }
    .pf-arrow:nth-of-type(3) em { animation-delay: .7s; }
    @keyframes pfRun { 0%{left:0;opacity:0} 20%{opacity:1} 80%{opacity:1} 100%{left:calc(100% - 6px);opacity:0} }
    .pf-note { margin: 10px 0 0; font-size: .74rem; color: var(--muted); line-height: 1.5; }

    /* 다음 한 칸 */
    .nx { display: flex; align-items: center; gap: 11px; text-decoration: none; border-radius: 14px; padding: 13px 14px;
      background: linear-gradient(135deg, rgba(255,106,61,.12), rgba(255,180,87,.08));
      border: 1px solid rgba(255,106,61,.28); transition: .25s var(--ease); }
    .nx:hover { transform: translateY(-3px); box-shadow: var(--shadow-soft); border-color: var(--accent); }
    .nx-ic { font-size: 1.4rem; flex: none; }
    .nx-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .nx-body b { font-size: .92rem; font-weight: 800; letter-spacing: -.02em; color: var(--fg); }
    .nx-body i { font-style: normal; font-size: .76rem; color: var(--muted); line-height: 1.45; }
    .nx-xp { margin-left: auto; flex: none; font-family: var(--mono); font-size: .72rem; font-weight: 700;
      color: #fff; background: var(--accent); border-radius: 999px; padding: 4px 9px; }

    /* 업적 카드 */
    .cw { display: flex; flex-direction: column; gap: 8px; }
    .cw-top { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
    .cw-n { font-weight: 800; font-size: 1.02rem; letter-spacing: -.025em; }
    .cw-meta { font-size: .7rem; color: var(--muted); }
    .cw-gene { margin-left: auto; font-size: .72rem; font-weight: 700; color: var(--cwc); }
    .cw-core { margin: 0; font-size: .87rem; line-height: 1.62; color: var(--fg-soft); }
    .cw-q { margin: 2px 0 0; padding: 10px 13px; border-radius: 12px; font-size: .85rem; line-height: 1.6; color: var(--fg);
      background: color-mix(in srgb, var(--cwc) 9%, var(--bg-2)); border-left: 3px solid var(--cwc); }
    .cw-go { font-size: .74rem; font-weight: 700; color: var(--cwc); text-decoration: none; }

    /* 업적 */
    .bg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(52px, 1fr)); gap: 7px; }
    .bg { position: relative; aspect-ratio: 1; border-radius: 13px; display: grid; place-items: center;
      background: var(--bg-2); border: 1px solid var(--line); cursor: help; transition: .25s var(--ease);
      font-size: 1.15rem; filter: grayscale(1) opacity(.42); }
    .bg.got { filter: none; background: linear-gradient(160deg, rgba(255,180,87,.24), var(--bg-1)); border-color: var(--accent); }
    .bg:hover { transform: translateY(-4px) scale(1.06); z-index: 2; }
    .bg .bg-ring { position: absolute; inset: -1px; border-radius: inherit; pointer-events: none;
      background: conic-gradient(var(--accent) calc(var(--p) * 1%), transparent 0); opacity: .22; }
    .bg.got .bg-ring { opacity: 0; }
    .bg-tip { position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(4px);
      width: max-content; max-width: 230px; background: var(--fg); color: var(--bg); border-radius: 11px; padding: 9px 12px;
      font-size: .72rem; line-height: 1.5; opacity: 0; visibility: hidden; transition: .2s var(--ease); z-index: 5; text-align: left; }
    .bg-tip b { display: block; font-size: .78rem; margin-bottom: 2px; }
    .bg-tip i { font-style: normal; opacity: .78; }
    .bg:hover .bg-tip { opacity: 1; visibility: visible; transform: translateX(-50%); }
    .bg-grid.all { grid-template-columns: repeat(auto-fill, minmax(46px, 1fr)); }

    /* 축하 */
    .cele { position: fixed; inset: 0; z-index: 120; display: grid; place-items: center; background: rgba(28,18,12,.5);
      backdrop-filter: blur(4px); animation: celeIn .3s var(--ease); }
    .cele[hidden] { display: none !important; }
    @keyframes celeIn { from { opacity: 0; } to { opacity: 1; } }
    /* 컨페티는 장식이다 — 클릭을 절대 가로막으면 안 된다 (자가검수에서 잡힌 버그) */
    .cele canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
    .cele-card { position: relative; z-index: 2; width: min(400px, calc(100vw - 40px)); text-align: center;
      background: var(--bg-1); border: 1px solid var(--line); border-radius: 26px; padding: 34px 30px 28px;
      box-shadow: 0 40px 90px rgba(80,40,10,.4); animation: celePop .55s var(--ease); }
    @keyframes celePop { 0% { opacity: 0; transform: scale(.75) translateY(20px); } 60% { transform: scale(1.04); } 100% { opacity: 1; transform: none; } }
    .cele-ic { font-size: 3.4rem; line-height: 1; display: block; animation: celeSpin 1s var(--ease); }
    @keyframes celeSpin { from { transform: rotate(-18deg) scale(.5); } to { transform: none; } }
    .cele-kick { font-family: var(--mono); font-size: .68rem; letter-spacing: .18em; color: var(--accent); margin: 14px 0 6px; }
    .cele-t { font-size: 1.5rem; font-weight: 800; letter-spacing: -.03em; margin: 0 0 6px; }
    .cele-who { font-size: .82rem; color: var(--muted); margin: 0 0 14px; }
    .cele-why { font-size: .9rem; line-height: 1.6; color: var(--fg-soft); margin: 0 0 18px; padding: 12px 14px;
      background: var(--bg-2); border-radius: 13px; }
    .cele-x { border: 0; cursor: pointer; font-family: inherit; font-weight: 700; font-size: .9rem;
      border-radius: 999px; padding: 11px 26px; background: var(--fg); color: var(--bg); }

    @media (max-width: 980px) {
      .dk-grid { grid-template-columns: 1fr; }
      .dk-grid2 { grid-template-columns: 1fr; }
      .dk-top { grid-template-columns: 1fr; gap: 18px; }
      .dk-level { justify-content: flex-start; }
    }
    @media (max-width: 560px) {
      .dk-cap { flex-wrap: wrap; border-radius: 20px; padding: 12px 14px; }
      .dk-cap input { flex: 1 1 100%; order: 2; }
      .dk-cap-btn { order: 3; margin-left: auto; padding: 10px 20px; }
      .dk-cap-ic { order: 1; }
      .dk-route { left: 10px; right: 10px; }
      .dk-lvinfo { min-width: 0; flex: 1; }
      .pf b { font-size: 1.05rem; }
      .pf span { font-size: .6rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pf-arrow em { animation: none; }
      .cele, .cele-card, .cele-ic { animation: none; }
    }
  </style>

  <script>
    // ══════════════════════════════════════════════════════════
    //  아라미 데크 엔진 — XP는 오직 행동에서 나온다.
    // ══════════════════════════════════════════════════════════
    import * as OS from '../lib/os-core.js';
    import * as G from '../lib/game.js';

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const KIND = Object.fromEntries(OS.KINDS.map((k) => [k.id, k]));

    /* ── 레벨 · XP ── */
    function paintLevel(s) {
      $('rkIc').textContent = s.levelInfo.ic;
      $('rkLv').textContent = 'Lv ' + s.level;
      $('rkName').textContent = s.levelInfo.ko;
      const C = 2 * Math.PI * 52;
      $('rkFg').style.strokeDasharray = String(C);
      $('rkFg').style.strokeDashoffset = String(C - C * (s.isMax ? 1 : s.frac));
      $('dkXpFill').style.width = Math.max(3, Math.round((s.isMax ? 1 : s.frac) * 100)) + '%';
      $('dkXp').textContent = String(s.xp);
      $('dkXpNext').textContent = s.isMax ? '—' : String(s.next.at);
      $('dkXpLeft').textContent = s.isMax ? '만렙 🪞' : String(Math.max(0, s.next.at - s.xp));
      $('dkStreak').textContent = String(s.streak);
      $('dkToday').textContent = String(s.today);
      $('dkAsset').textContent = String(s.assets);
      $('dkRate').textContent = s.promoteRate + '%';
      $('dkSay').textContent = s.total ? s.levelInfo.say : '던지면 알아서 제자리에 쌓이고, 쌓인 게 한 칸씩 올라가요.';
    }

    /* ── 오늘의 미션 ── */
    function paintMissions() {
      const { missions, cleared } = G.todayMissions();
      $('dkMissList').innerHTML = missions.map((m) => `
        <li class="miss ${m.done ? 'on' : ''}">
          <span class="mk">✓</span><span class="mi">${m.ic}</span>
          <span class="mt">${esc(m.ko)}</span><span class="mh">${esc(m.hint)}</span>
        </li>`).join('');
      $('dkMissN').textContent = cleared + '/3';
      $('dkMissFill').style.width = Math.round((cleared / 3) * 100) + '%';
    }

    /* ── 파이프라인 ── */
    function paintPipe(s) {
      $('pfInbox').textContent = String(s.inbox);
      $('pfSorted').textContent = String(s.sorted);
      $('pfWiki').textContent = String(s.wiki);
      $('pfAsset').textContent = String(s.assets);
      const n = $('dkPipeNote');
      if (!s.total) n.textContent = '아직 던진 게 없어요. 위에 한 줄 넣어보세요.';
      else if (s.assets) n.textContent = `던진 ${s.total}개 중 ${s.assets}개가 자산까지 올라갔어요 (승격률 ${s.promoteRate}%).`;
      else n.textContent = `${s.total}개 쌓였어요. 인박스에서 [승격 →]을 눌러 한 칸 올려보세요.`;
    }

    /* ── 다음 한 칸 ── */
    function paintNext() {
      const n = G.nextBest();
      $('nxIc').textContent = n.ic; $('nxT').textContent = n.t; $('nxD').textContent = n.d;
      $('nxXp').textContent = '+' + n.xp + ' XP';
      const a = $('dkNext');
      a.href = n.to;
      a.onclick = n.to === '#capture' ? (e) => { e.preventDefault(); $('dkIn').focus(); $('dkIn').scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' }); } : null;
    }

    /* ── 업적 ── */
    let showAll = false;
    function paintBadges() {
      const bs = G.badgeState();
      const got = bs.filter((b) => b.got).length;
      $('dkBadgeN').textContent = got + '/' + bs.length;
      const list = showAll ? bs : bs.slice().sort((a, b) => (b.got - a.got) || (b.pct - a.pct)).slice(0, 8);
      $('dkBadges').className = 'bg-grid' + (showAll ? ' all' : '');
      $('dkBadges').innerHTML = list.map((b) => `
        <span class="bg ${b.got ? 'got' : ''}" style="--p:${b.pct}">
          <i class="bg-ring"></i>${b.ic}
          <span class="bg-tip"><b>${b.ic} ${esc(b.ko)}</b>
            <i>${esc(b.how)} · ${b.cur}/${b.goal}</i><br /><i>← ${esc(b.who)}</i></span>
        </span>`).join('');
      $('dkBadgeToggle').textContent = showAll ? '접기' : '전부 보기';
    }
    $('dkBadgeToggle').addEventListener('click', () => { showAll = !showAll; paintBadges(); });

    /* ── 축하 (컨페티 + 카드) ── */
    function celebrate(b) {
      const box = $('cele'), card = $('celeCard');
      card.innerHTML = `
        <span class="cele-ic">${b.ic}</span>
        <p class="cele-kick">ACHIEVEMENT UNLOCKED</p>
        <h3 class="cele-t">${esc(b.ko)}</h3>
        <p class="cele-who">← ${esc(b.who)}</p>
        <p class="cele-why">${esc(b.why)}</p>
        <button class="cele-x" type="button">좋아요</button>`;
      box.hidden = false;
      card.querySelector('.cele-x').onclick = () => { box.hidden = true; };
      box.onclick = (e) => { if (e.target === box) box.hidden = true; };
      if (!reduce) confetti();
    }
    function confetti() {
      const cv = $('celeCv'); if (!cv) return;
      const ctx = cv.getContext('2d');
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = cv.clientWidth * dpr; cv.height = cv.clientHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const W = cv.clientWidth, H = cv.clientHeight;
      const cols = ['#ff6a3d', '#ffb457', '#ff4d6d', '#3fbf76', '#4a6fb0', '#a78bfa'];
      const ps = Array.from({ length: 130 }, () => ({
        x: W / 2 + (Math.random() - .5) * 160, y: H / 2 + (Math.random() - .5) * 60,
        vx: (Math.random() - .5) * 11, vy: -Math.random() * 13 - 3,
        w: 5 + Math.random() * 7, h: 8 + Math.random() * 9,
        r: Math.random() * Math.PI, vr: (Math.random() - .5) * .3,
        c: cols[(Math.random() * cols.length) | 0], life: 0,
      }));
      let t0 = 0;
      (function loop(ts) {
        if (!t0) t0 = ts;
        const el = ts - t0;
        ctx.clearRect(0, 0, W, H);
        ps.forEach((p) => {
          p.vy += 0.38; p.x += p.vx; p.y += p.vy; p.r += p.vr; p.life++;
          ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r);
          ctx.globalAlpha = Math.max(0, 1 - el / 2600);
          ctx.fillStyle = p.c; ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        if (el < 2600) requestAnimationFrame(loop); else ctx.clearRect(0, 0, W, H);
      })(0);
    }

    /* ── 한 줄 입력 ── */
    const inEl = $('dkIn'), routeEl = $('dkRoute');
    function preview() {
      const t = inEl.value.trim();
      if (!t) { routeEl.hidden = true; return; }
      const c = OS.classify(t);
      const k = KIND[c.kind] || { ic: '·', ko: c.kind };
      let h = k.ic + ' <b>' + esc(k.ko) + '</b> 으로 들어가요 — ' + esc(c.why);
      if (c.due) h += ' · 📅 ' + c.due;
      if (c.tags.length) h += ' · ' + c.tags.map((x) => '#' + esc(x)).join(' ');
      routeEl.innerHTML = h; routeEl.hidden = false;
    }
    inEl.addEventListener('input', preview);
    inEl.addEventListener('blur', () => setTimeout(() => { routeEl.hidden = true; }, 160));
    inEl.addEventListener('focus', preview);
    $('dkCapForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const t = inEl.value.trim();
      if (!t) { inEl.focus(); return; }
      OS.capture(t);
      inEl.value = ''; routeEl.hidden = true;
      flyToPipe();
      refresh();
    });
    // 던지면 종이가 인박스로 날아간다
    function flyToPipe() {
      if (reduce) return;
      const from = $('dkCapForm').getBoundingClientRect();
      const to = document.querySelector('.pf[data-s="inbox"]').getBoundingClientRect();
      const d = document.createElement('div');
      d.textContent = '📄';
      d.style.cssText = `position:fixed;z-index:110;left:${from.left + 30}px;top:${from.top + 14}px;font-size:22px;pointer-events:none`;
      document.body.appendChild(d);
      d.animate([
        { transform: 'translate(0,0) scale(1) rotate(0deg)', opacity: 1 },
        { transform: `translate(${to.left - from.left - 20}px, ${to.top - from.top + 6}px) scale(.5) rotate(320deg)`, opacity: 0 },
      ], { duration: 680, easing: 'cubic-bezier(.4,0,.2,1)' }).onfinish = () => d.remove();
    }

    /* ── 새로고침 ── */
    function refresh() {
      const s = G.snapshot();
      paintLevel(s); paintMissions(); paintPipe(s); paintNext(); paintBadges();
      const fresh = G.claimNew();
      if (fresh.length) setTimeout(() => celebrate(fresh[0]), 420);
    }
    OS.onChange(refresh);
    window.addEventListener('aramos:captured', refresh);
    refresh();
    // 첫 방문이면 이미 딴 배지를 축하로 몰지 않게 조용히 등록
    setTimeout(() => { G.claimNew(); }, 50);
  </script>

  <script is:inline>
    // ── 거울 지도(병합): 대륙 드릴다운 + 상태 필터 ──
    (function () {
      const view = document.getElementById('view');
      if (!view) return;
      const mapSec = document.getElementById('map');
      const conts = Array.from(document.querySelectorAll('.cont'));
      const details = Array.from(document.querySelectorAll('.detail'));
      function openDomain(key) {
        details.forEach((d) => { d.hidden = d.dataset.key !== key; });
        view.dataset.level = 'detail';
        if (mapSec) mapSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', '#' + key);
      }
      function backToMap() {
        view.dataset.level = 'overview';
        details.forEach((d) => { d.hidden = true; });
        history.replaceState(null, '', location.pathname);
        if (mapSec) mapSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      conts.forEach((c) => c.addEventListener('click', () => openDomain(c.dataset.key)));
      document.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', backToMap));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && view.dataset.level === 'detail') backToMap(); });
      details.forEach((d) => {
        const chips = Array.from(d.querySelectorAll('.fchip'));
        const places = Array.from(d.querySelectorAll('.place'));
        const noHit = d.querySelector('.no-hit');
        const regions = Array.from(d.querySelectorAll('.region'));
        chips.forEach((c) => c.addEventListener('click', () => {
          chips.forEach((x) => x.classList.toggle('on', x === c));
          const s = c.dataset.status;
          places.forEach((p) => { p.hidden = !(s === 'all' || p.dataset.status === s); });
          let any = false;
          regions.forEach((r) => { const vis = r.querySelector('.place:not([hidden])'); r.style.display = vis ? '' : 'none'; if (vis) any = true; });
          if (noHit) noHit.hidden = any;
        }));
      });
      const h = location.hash.replace('#', '');
      if (h && details.some((d) => d.dataset.key === h)) openDomain(h);
    })();
  </script>
</Base>
