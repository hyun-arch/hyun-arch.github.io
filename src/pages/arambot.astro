---
import Base from '../layouts/Base.astro';
// 아람봇 — 오톡 같은 FAQ·상담 챗봇을 아라미러 안에 완성한 버전.
// FAQ(아람휴비스·릴라이 공개 정보)를 "학습"한 지식베이스 + 키워드 매칭 엔진으로
// 정적 페이지에서도 즉석 응답한다. 못 맞추면 텔레그램(=나)으로 자연스럽게 넘긴다.
// ⚠️ 공개 배포되는 페이지라 매출·재무·B2C 사업계획 등 대외비는 넣지 않는다.
---
<Base title="아람봇 · Aram Bot">
  <section class="ab-hero">
    <div class="wrap">
      <div class="ab-head" data-reveal>
        <span class="ab-ava big" aria-hidden="true">
          <span class="ab-face"><span class="ab-eye l"></span><span class="ab-eye r"></span><span class="ab-cheek l"></span><span class="ab-cheek r"></span><span class="ab-mouth"></span></span>
          <span class="ab-spark s1">✦</span><span class="ab-spark s2">✧</span>
        </span>
        <div>
          <p class="section-kicker">Aram Bot · FAQ 챗봇</p>
          <h1>무엇이든 물어보세요, <mark>아람봇</mark>이 답해요</h1>
        </div>
      </div>
      <p class="ab-sub" data-reveal="100">
        아람휴비스·릴라이 정보를 <b>학습한 상담 챗봇</b>이에요. 궁금한 걸 편하게 물어보시면
        바로 답해드리고, 더 깊은 건 담당자(사장님)에게 톡으로 연결해 드려요.
      </p>
    </div>
  </section>

  <section class="ab-main">
    <div class="wrap ab-wrap">
      <div class="ab-window" data-reveal="60">
        <!-- 상단 바 -->
        <div class="ab-bar">
          <span class="ab-ava sm" aria-hidden="true">
            <span class="ab-face"><span class="ab-eye l"></span><span class="ab-eye r"></span><span class="ab-cheek l"></span><span class="ab-cheek r"></span><span class="ab-mouth"></span></span>
          </span>
          <div class="ab-bar-txt">
            <b>아람봇</b>
            <span class="ab-status"><i></i> 온라인 · 보통 몇 초 안에 답해요</span>
          </div>
          <button id="abReset" class="ab-reset" type="button" title="대화 새로 시작">↺</button>
        </div>

        <!-- 메시지 영역 -->
        <div class="ab-log" id="abLog" aria-live="polite"></div>

        <!-- 빠른 질문 칩 -->
        <div class="ab-chips" id="abChips"></div>

        <!-- 입력 -->
        <form class="ab-input" id="abForm">
          <input id="abText" type="text" autocomplete="off"
            placeholder="예) 아람휴비스는 어떤 회사예요?" aria-label="질문 입력" />
          <button class="ab-send" type="submit" aria-label="보내기">→</button>
        </form>
      </div>

      <p class="ab-note" data-reveal="120">
        💡 이 챗봇은 <b>오톡 같은 FAQ 상담봇</b>을 아라미러 안에 직접 만든 거예요.
        지식은 공개 정보 기준이라, 매출·내부 자료 같은 건 답하지 않고 사장님께 바로 연결해요.
      </p>
    </div>
  </section>

  <style>
    /* ── 아라미 봇 아바타 (자체완결) ── */
    .ab-ava { position: relative; display: inline-block; flex: 0 0 auto; }
    .ab-ava.big { width: 84px; height: 84px; }
    .ab-ava.sm { width: 40px; height: 40px; }
    .ab-ava.msg { width: 34px; height: 34px; }
    .ab-face { position: absolute; inset: 0; border-radius: 50% 50% 46% 46%;
      background: linear-gradient(160deg, #fff 0%, #ffe1cf 46%, #ffb199 100%);
      box-shadow: inset 0 -6px 13px rgba(255,120,90,.4), inset 0 6px 11px #fff, 0 8px 18px rgba(242,98,47,.28);
      animation: abBob 3.4s var(--ease) infinite; }
    .ab-ava.big .ab-face { animation: abFloat 4s var(--ease) infinite; }
    .ab-eye { position: absolute; top: 40%; width: 10%; height: 15%; background: #3a2418; border-radius: 50%; animation: abBlink 4.2s infinite; }
    .ab-eye::after { content: ""; position: absolute; top: 12%; left: 12%; width: 34%; height: 34%; background: #fff; border-radius: 50%; }
    .ab-eye.l { left: 32%; } .ab-eye.r { right: 32%; }
    .ab-cheek { position: absolute; top: 52%; width: 13%; height: 8%; border-radius: 50%; background: #ff9a8b; opacity: .6; filter: blur(.5px); }
    .ab-cheek.l { left: 24%; } .ab-cheek.r { right: 24%; }
    .ab-mouth { position: absolute; top: 58%; left: 50%; transform: translateX(-50%); width: 30%; height: 15%;
      border: 2.4px solid #3a2418; border-top: 0; border-radius: 0 0 40px 40px; }
    .ab-spark { position: absolute; font-size: 15px; color: var(--a2); animation: abTwinkle 2.4s ease-in-out infinite; }
    .ab-spark.s1 { top: -4%; right: -6%; } .ab-spark.s2 { bottom: 4%; left: -8%; color: var(--a3); animation-delay: .8s; font-size: 12px; }

    /* ── hero ── */
    .ab-hero { padding: 108px 0 8px; border-top: 0; }
    .ab-head { display: flex; align-items: center; gap: 20px; }
    .ab-head h1 { font-size: clamp(1.8rem, 4.6vw, 2.8rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.12; margin: 6px 0 0; }
    .ab-sub { max-width: 640px; margin: 18px 0 0; color: var(--fg-soft); font-size: 1.1rem; line-height: 1.7; }
    .ab-sub b { color: var(--fg); }

    .ab-main { padding: 26px 0 40px; border-top: 0; }
    .ab-wrap { max-width: 760px; }

    /* ── chat window ── */
    .ab-window { background: var(--bg-1); border: 1px solid var(--line); border-radius: 24px;
      box-shadow: var(--shadow); overflow: hidden; display: flex; flex-direction: column; }
    .ab-bar { display: flex; align-items: center; gap: 12px; padding: 14px 18px;
      background: linear-gradient(120deg, rgba(255,180,87,0.14), rgba(255,106,61,0.10));
      border-bottom: 1px solid var(--line); }
    .ab-bar-txt { display: flex; flex-direction: column; line-height: 1.3; }
    .ab-bar-txt b { font-size: 1.02rem; letter-spacing: -0.02em; }
    .ab-status { font-size: 0.78rem; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
    .ab-status i { width: 7px; height: 7px; border-radius: 50%; background: #34d3a0; box-shadow: 0 0 7px #34d3a0; animation: abPulse 2s infinite; }
    .ab-reset { margin-left: auto; background: none; border: 1px solid var(--line); color: var(--muted);
      width: 34px; height: 34px; border-radius: 50%; cursor: pointer; font-size: 1.1rem; transition: color .15s, border-color .15s, transform .15s; }
    .ab-reset:hover { color: var(--accent); border-color: var(--accent); transform: rotate(-40deg); }

    .ab-log { padding: 20px 18px 8px; height: 440px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px;
      scroll-behavior: smooth; background:
        radial-gradient(30rem 20rem at 90% -10%, rgba(255,180,87,0.06), transparent 60%), var(--bg-1); }
    .ab-row { display: flex; gap: 10px; align-items: flex-end; max-width: 88%; animation: abIn .34s var(--ease) both; }
    .ab-row.bot { align-self: flex-start; }
    .ab-row.me { align-self: flex-end; flex-direction: row-reverse; }
    .ab-bub { padding: 12px 16px; border-radius: 18px; font-size: 1rem; line-height: 1.62; }
    .ab-row.bot .ab-bub { background: var(--bg-2); border: 1px solid var(--line); border-bottom-left-radius: 6px; color: var(--fg); }
    .ab-row.me .ab-bub { background: var(--grad); color: #fff; border-bottom-right-radius: 6px; box-shadow: 0 8px 20px var(--accent-glow); }
    .ab-bub b { font-weight: 700; }
    .ab-row.bot .ab-bub b { color: var(--accent); }
    .ab-bub p { margin: 0 0 8px; } .ab-bub p:last-child { margin: 0; }
    .ab-bub a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
    .ab-bub ul { margin: 6px 0; padding-left: 18px; } .ab-bub li { margin: 2px 0; }

    /* typing dots */
    .ab-typing .ab-bub { display: inline-flex; gap: 5px; padding: 15px 18px; }
    .ab-typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); animation: abDot 1.2s infinite; }
    .ab-typing i:nth-child(2){ animation-delay: .18s; } .ab-typing i:nth-child(3){ animation-delay: .36s; }

    /* ── quick chips ── */
    .ab-chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 6px 16px 14px; }
    .ab-chip { background: var(--accent-soft); border: 1px solid rgba(242,98,47,0.24); color: var(--accent);
      font: inherit; font-size: 0.86rem; font-weight: 600; padding: 8px 14px; border-radius: 999px; cursor: pointer;
      transition: background .15s, transform .12s; }
    .ab-chip:hover { background: color-mix(in srgb, var(--accent) 18%, transparent); transform: translateY(-2px); }
    .ab-chip:active { transform: scale(.96); }

    /* ── input ── */
    .ab-input { display: flex; gap: 10px; padding: 14px 16px; border-top: 1px solid var(--line); background: var(--bg-1); }
    #abText { flex: 1; background: var(--bg-2); border: 1px solid var(--line); border-radius: 999px;
      padding: 13px 18px; font: inherit; font-size: 1rem; color: var(--fg); outline: none; transition: border-color .15s, box-shadow .15s; }
    #abText:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
    #abText::placeholder { color: var(--faint); }
    .ab-send { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
      background: var(--grad); color: #fff; font-size: 1.3rem; box-shadow: 0 8px 20px var(--accent-glow);
      transition: transform .15s, box-shadow .15s; }
    .ab-send:hover { transform: translateY(-2px) scale(1.04); box-shadow: 0 14px 30px var(--accent-glow); }
    .ab-send:active { transform: scale(.94); }

    .ab-note { margin: 18px 4px 0; font-size: 0.88rem; color: var(--muted); line-height: 1.7; }
    .ab-note b { color: var(--fg-soft); }

    @keyframes abIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    @keyframes abFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    @keyframes abBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
    @keyframes abBlink { 0%,92%,100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
    @keyframes abTwinkle { 0%,100% { opacity: .25; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.15); } }
    @keyframes abPulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }
    @keyframes abDot { 0%,100% { transform: translateY(0); opacity: .5; } 50% { transform: translateY(-4px); opacity: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .ab-face, .ab-spark, .ab-eye, .ab-status i, .ab-row, .ab-typing i { animation: none !important; }
    }
    @media (max-width: 680px) {
      .ab-hero { padding: 90px 0 4px; }
      .ab-head { gap: 14px; } .ab-ava.big { width: 66px; height: 66px; }
      .ab-log { height: 52vh; }
      .ab-row { max-width: 94%; }
    }
  </style>

  <script is:inline>
    (function () {
      var $ = function (id){ return document.getElementById(id); };
      var log = $('abLog'), chipsBox = $('abChips'), form = $('abForm'), input = $('abText');

      // ── 지식베이스 (FAQ) — 공개 정보만. 각 항목: 키워드 + 답변 + 후속칩 ──
      var KB = [
        { id:'company', kw:['아람휴비스','아람 휴비스','아람휴','회사','기업','뭐하는','무슨 회사','어떤 회사','소개','아람'],
          a:['<b>아람휴비스(Aram Huvis)</b>는 이름 그대로 <b>"아름다운 사람"</b>을 뜻해요. 사람의 피부와 두피를 <b>과학적으로 진단·분석하는 기기와 솔루션</b>을 만드는 회사예요.',
             '전 세계 뷰티·화장품 기업에 진단 기술을 공급하고, 매출의 상당 부분이 <b>해외</b>에서 나와요. 글로벌 뷰티 대기업들이 아람휴비스의 진단 솔루션을 쓰고 있어요.'],
          chips:['무슨 제품을 만들어요?','릴라이가 뭐예요?','해외 사업은?'] },

        { id:'product', kw:['제품','진단기','기기','디바이스','만들','솔루션','측정','분석기','장비','뭘 만'],
          a:['아람휴비스는 <b>피부·두피 진단기기</b>를 만들어요. 카메라·센서로 피부 상태(수분, 모공, 색소, 주름 등)와 두피 상태(모발 굵기·밀도, 두피 건강)를 <b>수치로 측정</b>해 주는 기기예요.',
             '여기에 <b>AI 분석</b>을 더해서, 찍기만 하면 "지금 상태가 어떤지 + 뭐가 필요한지"를 알려줘요. 화장품 매장·피부과·연구소 등에서 쓰여요.'],
          chips:['릴라이가 뭐예요?','두피 진단은 어떻게 해요?','구매·도입 문의'] },

        { id:'lilai', kw:['릴라이','lilai','두피케어','두피 케어','맞춤 화장품','팩트','브랜드','맞춤','케어'],
          a:['<b>릴라이(Lilai)</b>는 아람휴비스의 <b>AI 맞춤 두피케어 브랜드</b>예요. <b>두피를 진단</b>한 다음, 그 사람 상태에 맞는 <b>맞춤 케어 제품</b>을 제안하는 게 핵심이에요.',
             '"진단 → 나에게 딱 맞는 케어"로 이어지는 흐름이라, 아무 제품이나 쓰는 게 아니라 <b>내 두피에 맞춘</b> 걸 쓰게 돼요.',
             '자세한 브랜드 소개는 <a href="https://lilai.ai" target="_blank" rel="noopener">lilai.ai</a> 에서 볼 수 있어요.'],
          chips:['두피 진단은 어떻게 해요?','아람휴비스는 어떤 회사?','구매·도입 문의'] },

        { id:'diagnosis', kw:['진단','어떻게','측정 방법','원리','스캔','찍','분석 방법','피부 진단','두피 진단'],
          a:['진단은 아주 간단해요. <b>전용 카메라·센서로 피부나 두피를 촬영</b>하면, 기기가 상태를 <b>수치와 이미지</b>로 보여줘요.',
             '그다음 <b>AI가 결과를 해석</b>해서 "지금 어떤 상태이고, 어떤 관리가 필요한지"를 쉬운 말로 알려줘요. 몇 초면 끝나고, 전문지식 없이도 볼 수 있게 만든 게 강점이에요.'],
          chips:['릴라이가 뭐예요?','무슨 제품을 만들어요?'] },

        { id:'global', kw:['해외','글로벌','수출','세계','로레알','고객사','파트너','거래처','수출 비중'],
          a:['아람휴비스는 <b>해외 매출 비중이 매우 높은</b> 글로벌 회사예요. 세계적인 <b>뷰티·화장품 대기업들</b>이 아람휴비스의 진단 기술을 도입해 쓰고 있어요.',
             '"국내 강소기업"이 아니라 <b>처음부터 세계 시장</b>을 보고 움직이는 회사라고 보시면 돼요.'],
          chips:['무슨 제품을 만들어요?','아람휴비스는 어떤 회사?'] },

        { id:'buy', kw:['구매','도입','문의','견적','가격','얼마','사고','계약','상담','연락','도입하고','팔','판매'],
          a:['제품 <b>도입·구매·견적</b>은 담당자와 바로 상담하시는 게 제일 빨라요. 아래 톡으로 남겨주시면 사장님(담당)이 직접 확인하고 답드려요.',
             '<a href="https://t.me/Arami_claude_bot" target="_blank" rel="noopener">👉 톡으로 상담 남기기</a> · 또는 <a href="https://lilai.ai" target="_blank" rel="noopener">lilai.ai</a>'],
          chips:['무슨 제품을 만들어요?','릴라이가 뭐예요?'] },

        { id:'about-bot', kw:['아람봇','너 누구','넌 뭐','봇','챗봇','이 사이트','아라미러','뭐야 너','누구야','너는'],
          a:['저는 <b>아람봇</b>이에요! 🤖 아람휴비스·릴라이 정보를 학습해서, 궁금한 걸 물어보면 바로 답해드리는 상담 챗봇이에요.',
             '제가 모르는 건(내부 자료·매출 같은 건) 답하지 않고, <b>담당자에게 바로 연결</b>해 드려요. 편하게 물어보세요!'],
          chips:['아람휴비스는 어떤 회사?','무슨 제품을 만들어요?','릴라이가 뭐예요?'] },

        { id:'hi', kw:['안녕','하이','반가','ㅎㅇ','hello','hi','안뇽','좋은 아침','수고'],
          a:['안녕하세요! 😊 저는 <b>아람봇</b>이에요. 아람휴비스·릴라이에 대해 뭐든 물어보세요.'],
          chips:['아람휴비스는 어떤 회사?','릴라이가 뭐예요?','무슨 제품을 만들어요?'] },

        { id:'thanks', kw:['고마','감사','ㄱㅅ','thank','땡큐','굿','좋아','최고'],
          a:['도움이 됐다니 기뻐요! 😊 더 궁금한 게 있으면 언제든 물어보세요.'],
          chips:['릴라이가 뭐예요?','구매·도입 문의'] }
      ];

      var STARTERS = ['아람휴비스는 어떤 회사예요?','무슨 제품을 만들어요?','릴라이가 뭐예요?','구매·도입 문의'];

      function norm(s){ return (s||'').toLowerCase().replace(/[?!.,~\s]/g,''); }

      function match(text){
        var t = norm(text), best = null, bestScore = 0;
        for (var i=0;i<KB.length;i++){
          var e = KB[i], score = 0;
          for (var j=0;j<e.kw.length;j++){
            var k = norm(e.kw[j]);
            if (k && t.indexOf(k) !== -1) score += Math.min(k.length, 6);
          }
          if (score > bestScore){ bestScore = score; best = e; }
        }
        return bestScore >= 2 ? best : null;
      }

      function escapeText(s){ var d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

      function addRow(who, htmlParts, isTyping){
        var row = document.createElement('div');
        row.className = 'ab-row ' + who + (isTyping ? ' ab-typing' : '');
        if (who === 'bot'){
          var av = document.createElement('span'); av.className='ab-ava msg'; av.setAttribute('aria-hidden','true');
          av.innerHTML = '<span class="ab-face"><span class="ab-eye l"></span><span class="ab-eye r"></span><span class="ab-cheek l"></span><span class="ab-cheek r"></span><span class="ab-mouth"></span></span>';
          row.appendChild(av);
        }
        var bub = document.createElement('div'); bub.className='ab-bub';
        if (isTyping){ bub.innerHTML = '<i></i><i></i><i></i>'; }
        else if (typeof htmlParts === 'string'){ bub.innerHTML = '<p>'+htmlParts+'</p>'; }
        else { bub.innerHTML = htmlParts.map(function(p){ return '<p>'+p+'</p>'; }).join(''); }
        row.appendChild(bub);
        log.appendChild(row);
        log.scrollTop = log.scrollHeight;
        return row;
      }

      function renderChips(list){
        chipsBox.innerHTML = '';
        (list || STARTERS).forEach(function(c){
          var b = document.createElement('button'); b.className='ab-chip'; b.type='button'; b.textContent=c;
          b.addEventListener('click', function(){ send(c); });
          chipsBox.appendChild(b);
        });
      }

      var busy = false;
      function botReply(userText){
        busy = true;
        var typing = addRow('bot', null, true);
        var hit = match(userText);
        setTimeout(function(){
          typing.remove();
          if (hit){
            addRow('bot', hit.a);
            renderChips(hit.chips);
          } else {
            addRow('bot', [
              '음, 그건 제가 정확히 답하기 어려운 내용이에요. 🙏 아람휴비스·릴라이의 <b>제품·회사·두피진단</b>에 대해선 잘 답할 수 있어요.',
              '더 자세하거나 내부적인 건 <b>담당자(사장님)</b>가 직접 답하는 게 정확해요 → <a href="https://t.me/Arami_claude_bot" target="_blank" rel="noopener">톡으로 물어보기</a>'
            ]);
            renderChips(STARTERS);
          }
          busy = false;
        }, 500 + Math.random()*350);
      }

      function send(text){
        var t = (text != null ? text : input.value).trim();
        if (!t || busy) return;
        addRow('me', escapeText(t));
        input.value = '';
        botReply(t);
      }

      form.addEventListener('submit', function(e){ e.preventDefault(); send(); });
      $('abReset').addEventListener('click', function(){ log.innerHTML=''; greet(); });

      function greet(){
        addRow('bot', [
          '안녕하세요 사장님 👋 저는 <b>아람봇</b>이에요.',
          '아람휴비스·릴라이에 대해 궁금한 걸 물어보세요. 아래 버튼을 눌러도 되고, 직접 입력해도 돼요.'
        ]);
        renderChips(STARTERS);
      }
      greet();
      input.focus();
    })();
  </script>
</Base>
