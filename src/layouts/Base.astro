---
import '../styles/global.css';
import { domains } from '../data/mirror.js';

// ── 전역 검색 색인 (⌘K 커맨드 팔레트용) ──
// 아람미러의 모든 것을 한 곳에서 찾아 열 수 있어야 한다. 마찰 0.
const navIndex = [
  { t: '홈', h: '/', k: 'page' },
  { t: '흑자전환 OS (150일)', h: '/os', k: 'page' },
  { t: '총괄실 대시보드', h: '/hq/index.html', k: 'page' },
  { t: '금고 — 매출·재무', h: '/vault', k: 'page' },
  { t: '관리자', h: '/admin', k: 'page' },
  { t: '인박스 — 승격 파이프라인', h: '/inbox', k: 'page' },
  { t: '아람봇 — FAQ 상담', h: '/arambot', k: 'page' },
  { t: '받아쓰기 (음성→글자)', h: '/stt', k: 'page' },
  { t: '되묻기 · 멘토', h: '/ask', k: 'page' },
  { t: '책장 (분류함)', h: '/shelf', k: 'page' },
  { t: '자료실', h: '/archive', k: 'page' },
  { t: '생각의 벽', h: '/wall', k: 'page' },
  { t: '글', h: '/writings', k: 'page' },
  { t: '독서 · 학습', h: '/reading', k: 'page' },
  { t: '게시판', h: '/board', k: 'page' },
  { t: '발행', h: '/publish', k: 'page' },
  { t: '몰입 · Flow', h: '/flow', k: 'page' },
  { t: '거장 & 스승', h: '/masters', k: 'page' },
  { t: '스폰지 시계', h: '/sponge', k: 'page' },
  { t: '세계 시계', h: '/world', k: 'page' },
  { t: '농구클럽 · GTB', h: '/gtb', k: 'page' },
  { t: '스튜디오팀 구조', h: '/studio-team', k: 'page' },
  { t: '캐러셀 스튜디오', h: '/studio', k: 'page' },
  { t: '릴스 스튜디오', h: '/reels', k: 'page' },
  { t: '셸 스튜디오', h: '/shell-studio', k: 'page' },
  { t: '달력', h: '/calendar', k: 'page' },
  { t: 'Build Logs', h: '/build-logs', k: 'page' },
  { t: '작동 방식', h: '/how', k: 'page' },
];
const mapIndex = domains.flatMap((d) =>
  d.branches.flatMap((b) =>
    b.items.map((it) => ({
      t: it.t, h: it.to || '/m/' + it.slug, k: 'map',
      d: d.title, s: it.status,  
    }))
  )
);
const crewIndex = [];
const searchIndex = [...navIndex, ...mapIndex, ...crewIndex];

const { title, frontmatter } = Astro.props;
const pageTitle = frontmatter?.title ?? title ?? 'Aramirror';
const desc = frontmatter?.description ?? 'AI는 나를 대신하지 않는다 — 거울이 된다. 내 생각이 자산·가치로 기능하는 환경.';
const isMarkdown = Boolean(frontmatter);

// OG 이미지 자동생성 무기: 페이지 경로 → /og/<slug>.png (빌드타임 생성분과 매칭)
const path = Astro.url.pathname.replace(/\/$/, '');
const ogMatch = path.match(/^\/((?:build-logs|writings)\/[^/]+)$/);
const ogKey = ogMatch ? ogMatch[1] : 'home';
const ogImage = new URL(`/og/${ogKey}.png`, Astro.site).href;
const pageUrl = new URL(path || '/', Astro.site).href;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} · Aramirror</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#ffffff" />
    <!-- 등장 애니메이션 활성화 표시. JS가 실제로 도는 경우에만 콘텐츠를 숨겼다 보여준다. -->
    <script is:inline>document.documentElement.classList.add('reveal-js');</script>
    <!-- OG / 공유카드 (자동생성 이미지) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aramirror" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Spline+Sans+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <nav class="nav">
      <div class="wrap">
        <a class="brand" href="/">Aramirror<span class="dot">.</span></a>
        <button class="nav-toggle" aria-label="메뉴 열기" aria-expanded="false">☰</button>
        <div class="links" id="navLinks">
          <div class="nav-group">
            <button class="nav-top nav-top--hq" type="button">총괄실</button>
            <div class="nav-menu">
              <a href="/os">🔥 흑자전환 OS (150일)</a>
              <a href="/hq/index.html">대시보드</a>
              <a href="/vault">🔴 금고 (매출·재무)</a>
              <a href="/admin">관리자</a>
            </div>
          </div>
          <div class="nav-group">
            <button class="nav-top" type="button">세컨드브레인</button>
            <div class="nav-menu">
              <a href="/core">🪨 코어 (하루 한 질문)</a>
              <a href="/inbox">📥 인박스 (던진 것 → 자산)</a>
              <a href="/arambot">🤖 아람봇 (FAQ 상담)</a>
              <a href="/stt">🎙️ 받아쓰기 (음성→글자)</a>
              <a href="/ask">되묻기 · 멘토</a>
              <a href="/shelf">📚 책장 (분류함)</a>
              <a href="/archive">📥 자료실</a>
              <a href="/wall">생각의 벽</a>
              <a href="/writings">글</a>
              <a href="/reading">독서 · 학습</a>
              <a href="/board">게시판</a>
              <a href="/publish">발행</a>
            </div>
          </div>
          <div class="nav-group">
            <button class="nav-top" type="button">시간 · 몰입</button>
            <div class="nav-menu">
              <a href="/flow">몰입 · Flow</a>
              <a href="/masters">거장 &amp; 스승</a>
              <a href="/sponge">스폰지 시계</a>
              <a href="/world">세계 시계</a>
            </div>
          </div>
          <div class="nav-group">
            <button class="nav-top" type="button">프로젝트</button>
            <div class="nav-menu">
              <a href="/gtb">농구클럽 · GTB</a>
              <a href="/studio-team">🎬 스튜디오팀 구조</a>
              <a href="/studio">└ 캐러셀 스튜디오</a>
              <a href="/reels">└ 릴스 스튜디오</a>
              <a href="/shell-studio">└ 셸 스튜디오</a>
              <a href="/calendar">달력 (Luxe Calendar)</a>
            </div>
          </div>
          <div class="nav-group">
            <button class="nav-top" type="button">기록 · 안내</button>
            <div class="nav-menu">
              <a href="/build-logs">Build Logs</a>
              <a href="/how">작동 방식</a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    {isMarkdown ? (
      <main class="wrap prose"><slot /></main>
    ) : (
      <slot />
    )}

    <!-- ══════════════════════════════════════════════════════════
         전역 OS 레이어 — 아람미러 어느 페이지에서든 살아있다.
         ══════════════════════════════════════════════════════════ -->

    <!-- ⚡ 퀵캡처 독 : 던지는 순간과 저장되는 순간의 거리를 0으로 -->
    <div class="os-dock" id="osDock">
      <button class="os-fab" id="osFab" type="button" aria-label="한 줄 던지기 (C)" title="한 줄 던지기 · C">
        <span class="os-fab-ic">⚡</span>
        <span class="os-fab-n" id="osFabN" hidden>0</span>
      </button>
      <div class="os-cap" id="osCap" hidden>
        <div class="os-cap-top">
          <span class="os-cap-t">⚡ 한 줄 던지기</span>
          <a class="os-cap-go" href="/inbox">인박스 →</a>
          <button class="os-cap-x" id="osCapX" type="button" aria-label="닫기">✕</button>
        </div>
        <textarea id="osCapIn" rows="2" placeholder="아무거나. 알아서 분류돼요 —  예) 내일 10시 경영회의 / 이번 주까지 지표 정리 #경영 / https://..."></textarea>
        <div class="os-cap-route" id="osCapRoute" hidden></div>
        <div class="os-cap-bot">
          <span class="os-cap-hint">⌘/Ctrl + Enter 로 저장</span>
          <button class="os-cap-save" id="osCapSave" type="button">던지기</button>
        </div>
        <div class="os-cap-recent" id="osCapRecent"></div>
      </div>
    </div>

    <!-- 🔁 먼저 말 거는 루프 : 내가 열어야 도는 시스템은 안 돈다 -->
    <div class="os-nudge" id="osNudge" hidden>
      <span class="os-nudge-ic" id="osNudgeIc">📌</span>
      <span class="os-nudge-msg" id="osNudgeMsg"></span>
      <a class="os-nudge-go" id="osNudgeGo" href="/inbox">보기</a>
      <button class="os-nudge-x" id="osNudgeX" type="button" aria-label="나중에">나중에</button>
    </div>

    <!-- ⌘K 커맨드 팔레트 : 아람미러 전체를 한 곳에서 검색·이동 -->
    <div class="os-pal-scrim" id="osPalScrim" hidden></div>
    <div class="os-pal" id="osPal" hidden role="dialog" aria-modal="true" aria-label="전체 검색">
      <div class="os-pal-in">
        <span class="os-pal-ic">⌘</span>
        <input id="osPalQ" type="text" placeholder="페이지 · 지도 부품 · 내가 던진 것 — 전부 검색" autocomplete="off" />
        <kbd>ESC</kbd>
      </div>
      <div class="os-pal-list" id="osPalList"></div>
      <div class="os-pal-foot">
        <span><kbd>↑</kbd><kbd>↓</kbd> 이동</span><span><kbd>↵</kbd> 열기</span><span><kbd>C</kbd> 한 줄 던지기</span>
      </div>
    </div>

    <script type="application/json" id="osIndex" set:html={JSON.stringify({ idx: searchIndex })} />

    <footer>
      <div class="wrap">
        <div class="foot-links">
          <a href="/hq/index.html">총괄실</a>
          <a href="/how">작동 방식</a>
          <a href="/gtb">농구클럽 · GTB</a>
        </div>
        Aramirror — 아람, 아름다운 사람. AI는 거울이 된다.<br />
        © 2026 Aram Huvis · built with Claude Code
      </div>
    </footer>
    <style is:global>
      footer .foot-links { display:flex; flex-wrap:wrap; gap:16px; justify-content:center; margin-bottom:14px; }
      footer .foot-links a { color:inherit; text-decoration:underline; text-underline-offset:2px; font-size:0.9rem; }

      /* ===== 5층 그룹 네비게이션 ===== */
      .nav-solo {
        font-size:0.88rem; font-weight:700; color:var(--fg); text-decoration:none;
        padding:6px 12px; border-radius:999px; border:1px solid var(--accent);
        background:var(--accent-soft); transition:background .15s, transform .15s; white-space:nowrap;
      }
      .nav-solo:hover { background:color-mix(in srgb, var(--accent) 22%, transparent); transform:translateY(-1px); }
      .nav-solo::after { display:none; }
      .nav-toggle { display:none; background:none; border:0; color:var(--fg); font-size:1.4rem; cursor:pointer; margin-left:auto; line-height:1; padding:6px; }
      .nav .links { align-items:center; }
      .nav-group { position:relative; }
      .nav-top {
        background:none; border:0; color:var(--muted); font:inherit; font-size:0.88rem;
        cursor:pointer; padding:6px 2px; display:inline-flex; align-items:center; gap:5px; letter-spacing:-0.01em;
      }
      .nav-top::after { content:"▾"; font-size:0.7em; opacity:0.6; transition:transform .2s; }
      .nav-group:hover .nav-top, .nav-group.open .nav-top { color:var(--fg); }
      .nav-group.open .nav-top::after { transform:rotate(180deg); }
      .nav-top--hq { color:var(--accent); font-weight:700; }
      .nav-top--hq::before { content:"●"; font-size:0.6em; vertical-align:middle; margin-right:2px; }
      .nav-menu {
        position:absolute; top:calc(100% + 10px); left:50%; transform:translateX(-50%) translateY(6px);
        min-width:172px; padding:8px; display:flex; flex-direction:column; gap:2px;
        background:var(--bg-1); border:1px solid var(--line); border-radius:14px;
        box-shadow:0 20px 44px rgba(196,110,54,0.20); opacity:0; visibility:hidden; transition:opacity .18s, transform .18s;
        z-index:60;
      }
      .nav-group:hover .nav-menu, .nav-group.open .nav-menu { opacity:1; visibility:visible; transform:translateX(-50%) translateY(0); }
      .nav-menu a { padding:9px 12px; border-radius:9px; font-size:0.9rem; color:var(--fg-soft); white-space:nowrap; }
      .nav-menu a:hover { background:var(--bg-2); color:var(--fg); }
      .nav-menu a::after { display:none; }

      /* ══════ 전역 OS 레이어 ══════ */
      .os-dock { position:fixed; right:20px; bottom:20px; z-index:70; display:flex; flex-direction:column; align-items:flex-end; gap:10px; }
      .os-fab {
        width:56px; height:56px; border-radius:50%; border:0; cursor:pointer; position:relative;
        background:var(--grad); color:#fff; font-size:1.4rem; line-height:1;
        box-shadow:0 12px 30px rgba(255,106,61,.36); transition:transform .25s var(--ease), box-shadow .25s var(--ease);
      }
      .os-fab:hover { transform:translateY(-3px) scale(1.05); box-shadow:0 18px 44px rgba(255,106,61,.5); }
      .os-fab:active { transform:scale(.96); }
      .os-fab-n {
        position:absolute; top:-2px; right:-2px; min-width:20px; height:20px; padding:0 5px;
        border-radius:999px; background:#2c2320; color:#fff; font-size:.68rem; font-weight:700;
        display:grid; place-items:center; font-family:var(--mono);
      }
      .os-cap {
        width:min(400px, calc(100vw - 40px)); background:var(--bg-1); border:1px solid var(--line);
        border-radius:18px; box-shadow:0 26px 60px rgba(120,70,30,.24); padding:14px 16px 12px;
        animation:osUp .26s var(--ease);
      }
      @keyframes osUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }
      .os-cap-top { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
      .os-cap-t { font-weight:800; font-size:.92rem; }
      .os-cap-go { margin-left:auto; font-size:.78rem; color:var(--accent); font-weight:700; }
      .os-cap-x { background:none; border:0; cursor:pointer; color:var(--muted); font-size:.85rem; padding:2px 4px; }
      .os-cap textarea {
        width:100%; font-family:inherit; font-size:.95rem; line-height:1.55; resize:vertical;
        border:1px solid var(--line); border-radius:12px; padding:10px 12px; background:var(--bg-2); color:var(--fg);
      }
      .os-cap textarea:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
      .os-cap-route {
        margin-top:8px; font-size:.78rem; color:var(--fg-soft); background:var(--bg-2);
        border:1px dashed var(--line); border-radius:10px; padding:8px 11px; line-height:1.5;
      }
      .os-cap-route b { color:var(--accent-strong); }
      .os-cap-bot { display:flex; align-items:center; gap:10px; margin-top:10px; }
      .os-cap-hint { font-size:.72rem; color:var(--faint); }
      .os-cap-save {
        margin-left:auto; font-family:inherit; font-weight:700; font-size:.86rem; cursor:pointer;
        border:0; border-radius:999px; padding:9px 20px; background:var(--fg); color:var(--bg);
        transition:transform .2s var(--ease);
      }
      .os-cap-save:hover { transform:translateY(-2px); }
      .os-cap-recent { margin-top:10px; display:flex; flex-direction:column; gap:5px; }
      .os-cap-recent .r {
        font-size:.78rem; color:var(--muted); display:flex; gap:7px; align-items:baseline;
        border-top:1px solid var(--line-soft); padding-top:6px;
      }
      .os-cap-recent .r i { font-style:normal; }
      .os-cap-recent .r span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

      .os-nudge {
        position:fixed; left:20px; bottom:22px; z-index:69; max-width:min(420px, calc(100vw - 40px));
        display:flex; align-items:center; gap:10px; padding:12px 14px;
        background:var(--bg-1); border:1px solid var(--line); border-left:4px solid var(--accent);
        border-radius:14px; box-shadow:0 18px 44px rgba(120,70,30,.18); animation:osUp .3s var(--ease);
      }
      .os-nudge.hot { border-left-color:#d94b3a; }
      .os-nudge.cool { border-left-color:#4a6fb0; }
      .os-nudge-ic { font-size:1.05rem; }
      .os-nudge-msg { font-size:.88rem; color:var(--fg); line-height:1.45; }
      .os-nudge-go { font-size:.8rem; font-weight:700; color:var(--accent); white-space:nowrap; margin-left:auto; }
      .os-nudge-x { background:none; border:0; cursor:pointer; color:var(--faint); font-size:.76rem; white-space:nowrap; }

      .os-pal-scrim { position:fixed; inset:0; z-index:90; background:rgba(30,20,12,.44); backdrop-filter:blur(3px); }
      .os-pal-scrim[hidden], .os-pal[hidden], .os-cap[hidden], .os-nudge[hidden] { display:none !important; }
      .os-pal {
        position:fixed; z-index:91; left:50%; top:12vh; transform:translateX(-50%);
        width:min(660px, calc(100vw - 32px)); background:var(--bg-1); border:1px solid var(--line);
        border-radius:20px; box-shadow:0 40px 90px rgba(90,50,20,.3); overflow:hidden;
        display:flex; flex-direction:column; max-height:72vh; animation:osPal .24s var(--ease);
      }
      @keyframes osPal { from{opacity:0;transform:translateX(-50%) translateY(-8px)} to{opacity:1;transform:translateX(-50%)} }
      .os-pal-in { display:flex; align-items:center; gap:10px; padding:15px 18px; border-bottom:1px solid var(--line); }
      .os-pal-ic { font-family:var(--mono); color:var(--accent); font-weight:700; }
      .os-pal-in input { flex:1; border:0; background:none; font-family:inherit; font-size:1.02rem; color:var(--fg); min-width:0; }
      .os-pal-in input:focus { outline:none; }
      .os-pal kbd, .os-pal-foot kbd {
        font-family:var(--mono); font-size:.66rem; border:1px solid var(--line); border-bottom-width:2px;
        border-radius:5px; padding:2px 6px; color:var(--muted); background:var(--bg-2);
      }
      .os-pal-list { overflow-y:auto; padding:6px; }
      .os-pal-row {
        display:flex; align-items:center; gap:10px; padding:10px 13px; border-radius:11px;
        cursor:pointer; text-decoration:none; color:var(--fg);
      }
      .os-pal-row.on, .os-pal-row:hover { background:var(--accent-soft); }
      .os-pal-k {
        font-family:var(--mono); font-size:.6rem; font-weight:700; padding:2px 7px; border-radius:5px;
        background:var(--bg-2); color:var(--muted); border:1px solid var(--line); white-space:nowrap;
      }
      .os-pal-t { font-weight:600; font-size:.94rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .os-pal-d { margin-left:auto; font-size:.75rem; color:var(--muted); white-space:nowrap; }
      .os-pal-empty { padding:30px 18px; text-align:center; color:var(--muted); font-size:.9rem; }
      .os-pal-foot {
        display:flex; gap:16px; padding:9px 18px; border-top:1px solid var(--line);
        background:var(--bg-2); font-size:.72rem; color:var(--muted); flex-wrap:wrap;
      }
      @media (max-width: 680px) {
        .os-dock { right:14px; bottom:14px; }
        /* 모바일에선 ⚡ 옆이 아니라 위로 — 겹치면 둘 다 못 누른다 */
        .os-nudge { left:14px; right:14px; bottom:82px; max-width:none; }
        .os-nudge-msg { font-size:.82rem; }
        .os-pal { top:6vh; max-height:84vh; }
      }
      @media (prefers-reduced-motion: reduce) { .os-cap, .os-nudge, .os-pal { animation:none; } }

      @media (max-width: 820px) {
        .nav-toggle { display:block; }
        .nav .wrap { flex-wrap:wrap; }
        .nav .links {
          flex-basis:100%; flex-direction:column; align-items:stretch; gap:2px;
          margin-left:0; max-height:0; overflow:hidden; transition:max-height .28s ease;
        }
        .nav .links.open { max-height:78vh; overflow-y:auto; padding-bottom:14px; }
        .nav-group { border-top:1px solid var(--line-soft); }
        .nav-top { width:100%; justify-content:space-between; padding:14px 4px; font-size:1rem; }
        .nav-menu {
          position:static; transform:none; opacity:1; visibility:visible; box-shadow:none;
          border:0; background:none; padding:0 0 8px 12px; min-width:0; display:none;
        }
        .nav-group.open .nav-menu { display:flex; transform:none; }
        .nav-group:hover .nav-menu { opacity:1; }
      }
    </style>

    <script is:inline>
      // scroll reveal — 요소가 뷰포트에 들어오면 스르륵 나타남.
      // is:inline 으로 즉시 실행(무거운 번들/네트워크에 안 묶임) + 안전장치로 절대 백지 안 됨.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        function showAll() { for (var i = 0; i < els.length; i++) els[i].classList.add('in'); }
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                var el = e.target;
                el.style.transitionDelay = (el.dataset.reveal ? Number(el.dataset.reveal) : 0) + 'ms';
                el.classList.add('in');
                io.unobserve(el);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          for (var i = 0; i < els.length; i++) io.observe(els[i]);
          // 안전장치: 어떤 이유로든 1초 안에 안 켜졌으면 전부 강제 표시(백지 방지)
          setTimeout(showAll, 1000);
        } else {
          showAll();
        }
      })();
    </script>

    <script>
      // 5층 그룹 네비 — 모바일 햄버거 + 그룹 펼치기
      const navToggle = document.querySelector('.nav-toggle');
      const navLinks = document.getElementById('navLinks');
      const groups = Array.from(document.querySelectorAll('.nav-group'));
      const isMobile = () => window.matchMedia('(max-width: 820px)').matches;

      navToggle?.addEventListener('click', () => {
        const open = navLinks?.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      groups.forEach((g) => {
        const top = g.querySelector('.nav-top');
        top?.addEventListener('click', (e) => {
          e.stopPropagation();
          const wasOpen = g.classList.contains('open');
          groups.forEach((o) => o.classList.remove('open'));
          if (!wasOpen) g.classList.add('open');
        });
      });

      // 바깥 클릭 시 닫기 (데스크톱 드롭다운)
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.nav-group')) {
          groups.forEach((o) => o.classList.remove('open'));
        }
      });
    </script>

    <script>
      // 지하 엔진실 — 모든 페이지 열람을 자동 기록하고 window.aramLog를 전역 노출
      import { logEvent } from '../lib/events.js';
      logEvent('page_view', { path: location.pathname, ref: document.referrer || null });
    </script>

    <script>
      // ══════════════════════════════════════════════════════════
      //  전역 OS 레이어 — 퀵캡처 · 커맨드 팔레트 · 먼저 말 거는 루프
      //  원칙을 "글"이 아니라 "동작"으로. 모든 페이지에서 산다.
      // ══════════════════════════════════════════════════════════
      import * as OS from '../lib/os-core.js';
      import * as GM from '../lib/game.js';
      window.aramOS = OS; // 콘솔에서도 만질 수 있게 — 내 데이터는 내 것
      window.aramGame = GM;

      const $ = (id) => document.getElementById(id);
      const idxEl = $('osIndex');
      const IDX = idxEl ? JSON.parse(idxEl.textContent || '{}') : { idx: [], axes: {} };
      const AXES = IDX.axes || {};

      /* ── 사용 로그 : 안 쓰는 기능이 드러나야 버릴 수 있다 ── */
      OS.logVisit(location.pathname);

      /* ── ⚡ 퀵캡처 ── */
      const dock = $('osDock'), fab = $('osFab'), cap = $('osCap');
      const capIn = $('osCapIn'), capRoute = $('osCapRoute'), capRecent = $('osCapRecent'), fabN = $('osFabN');
      const KIND = Object.fromEntries(OS.KINDS.map((k) => [k.id, k]));

      function refreshBadge() {
        const n = OS.getItems({ stage: 'inbox' }).length;
        if (!fabN) return;
        fabN.hidden = n === 0;
        fabN.textContent = String(n);
      }
      function refreshRecent() {
        if (!capRecent) return;
        const rs = OS.getItems().slice(0, 3);
        capRecent.innerHTML = rs.length
          ? rs.map((r) => {
              const k = KIND[r.kind] || { ic: '·', ko: '' };
              return '<div class="r"><i>' + k.ic + '</i><span>' + esc(r.text) + '</span></div>';
            }).join('')
          : '';
      }
      function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

      function openCap(prefill) {
        if (!cap) return;
        cap.hidden = false;
        if (prefill) capIn.value = prefill;
        capIn.focus();
        preview();
        refreshRecent();
      }
      function closeCap() { if (cap) cap.hidden = true; }

      // 던지기 전에 "어디로 갈지"를 미리 보여준다 — 라우터를 신뢰하려면 보여야 한다
      function preview() {
        if (!capIn || !capRoute) return;
        const t = capIn.value.trim();
        if (!t) { capRoute.hidden = true; return; }
        const c = OS.classify(t);
        const k = KIND[c.kind] || { ic: '·', ko: c.kind };
        let h = k.ic + ' <b>' + esc(k.ko) + '</b> 으로 들어가요 — ' + esc(c.why);
        if (c.due) h += ' · 📅 ' + c.due;
        if (c.tags.length) h += ' · ' + c.tags.map((x) => '#' + esc(x)).join(' ');
        if (c.src) h += ' · 🔗 미확인 자료';
        capRoute.innerHTML = h;
        capRoute.hidden = false;
      }
      function doCapture() {
        const t = capIn.value.trim();
        if (!t) return;
        OS.capture(t);
        capIn.value = '';
        preview(); refreshBadge(); refreshRecent();
        fab.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.25)' }, { transform: 'scale(1)' }], { duration: 320 });
        window.dispatchEvent(new CustomEvent('aramos:captured'));
      }

      fab?.addEventListener('click', () => (cap.hidden ? openCap() : closeCap()));
      $('osCapX')?.addEventListener('click', closeCap);
      $('osCapSave')?.addEventListener('click', doCapture);
      capIn?.addEventListener('input', preview);
      capIn?.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); doCapture(); }
        if (e.key === 'Escape') { e.stopPropagation(); closeCap(); }
      });
      document.addEventListener('click', (e) => {
        if (cap && !cap.hidden && !dock.contains(e.target)) closeCap();
      });

      /* ── ⌘K 커맨드 팔레트 ── */
      const pal = $('osPal'), palScrim = $('osPalScrim'), palQ = $('osPalQ'), palList = $('osPalList');
      let palRows = [], palAt = 0;

      function palSource() {
        const mine = OS.getItems().slice(0, 200).map((i) => {
          const k = KIND[i.kind] || { ic: '·', ko: '' };
          return { t: i.text, h: '/inbox#' + i.id, k: 'mine', d: k.ic + ' ' + k.ko };
        });
        return (IDX.idx || []).concat(mine);
      }
      const K_LABEL = { page: '페이지', map: '지도', mine: '내 것' };

      function palRender(q) {
        const all = palSource();
        const s = q.trim().toLowerCase();
        let rows = s
          ? all.filter((r) => (r.t + ' ' + (r.d || '') + ' ' + (r.sub || '') + ' ' + (r.from || '')).toLowerCase().includes(s))
          : all.filter((r) => r.k === 'page').slice(0, 12);
        rows = rows.slice(0, 40);
        palRows = rows; palAt = 0;
        if (!rows.length) { palList.innerHTML = '<p class="os-pal-empty">없어요. 다른 말로 찾아보세요.</p>'; return; }
        palList.innerHTML = rows.map((r, i) => {
          const g = r.axis && AXES[r.axis] ? AXES[r.axis].ic + ' ' : '';
          const d = [g + (r.d || ''), r.from ? '← ' + r.from : ''].filter(Boolean).join(' · ');
          return '<a class="os-pal-row' + (i === 0 ? ' on' : '') + '" href="' + esc(r.h) + '" data-i="' + i + '">' +
            '<span class="os-pal-k">' + (K_LABEL[r.k] || r.k) + '</span>' +
            '<span class="os-pal-t">' + esc(r.t) + '</span>' +
            (d ? '<span class="os-pal-d">' + esc(d) + '</span>' : '') + '</a>';
        }).join('');
      }
      function palMove(d) {
        const els = palList.querySelectorAll('.os-pal-row');
        if (!els.length) return;
        els[palAt]?.classList.remove('on');
        palAt = (palAt + d + els.length) % els.length;
        els[palAt].classList.add('on');
        els[palAt].scrollIntoView({ block: 'nearest' });
      }
      function palOpen() {
        pal.hidden = false; palScrim.hidden = false;
        palQ.value = ''; palRender(''); palQ.focus();
      }
      function palClose() { pal.hidden = true; palScrim.hidden = true; }

      palQ?.addEventListener('input', () => palRender(palQ.value));
      palScrim?.addEventListener('click', palClose);
      palQ?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); palMove(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); palMove(-1); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          const el = palList.querySelectorAll('.os-pal-row')[palAt];
          if (el) location.href = el.getAttribute('href');
        } else if (e.key === 'Escape') { palClose(); }
      });

      /* ── 전역 단축키 ── */
      document.addEventListener('keydown', (e) => {
        const tag = (e.target && e.target.tagName) || '';
        const typing = /INPUT|TEXTAREA|SELECT/.test(tag) || (e.target && e.target.isContentEditable);
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault(); pal.hidden ? palOpen() : palClose(); return;
        }
        if (typing) return;
        if (e.key === 'Escape') { palClose(); closeCap(); return; }
        if (e.key.toLowerCase() === 'c' && !e.metaKey && !e.ctrlKey && !e.altKey) { e.preventDefault(); openCap(); }
      });

      /* ── 🔁 먼저 말 거는 루프 ── */
      const nud = $('osNudge');
      function showNudge() {
        if (!nud) return;
        const n = OS.nudge();
        if (!n) { nud.hidden = true; return; }
        nud.className = 'os-nudge ' + n.level;
        $('osNudgeIc').textContent = n.ic;
        $('osNudgeMsg').textContent = n.msg;
        const go = $('osNudgeGo');
        if (n.to === '#capture') {
          go.textContent = '한 줄 던지기'; go.href = '#';
          go.onclick = (e) => { e.preventDefault(); nud.hidden = true; openCap(); };
        } else { go.textContent = '보기'; go.href = n.to; go.onclick = null; }
        nud.hidden = false;
      }
      // 응답하면 '다시 온 알림' 업적이 오른다 (무시가 아니라 처리를 센다)
      $('osNudgeGo')?.addEventListener('click', () => { try { GM.bump('nudge'); } catch (e) {} });
      $('osNudgeX')?.addEventListener('click', () => { OS.snooze(4); nud.hidden = true; });

      // 상태가 바뀌면 넛지도 다시 판단한다 — 안 그러면 "아직 안 던지셨어요"가 던진 뒤에도 남는다
      var nudT;
      OS.onChange(() => {
        refreshBadge(); refreshRecent();
        clearTimeout(nudT);
        nudT = setTimeout(showNudge, 400);
      });
      refreshBadge();
      setTimeout(showNudge, 1400);

      // 해시로 바로 캡처 열기 (/#capture)
      if (location.hash === '#capture') setTimeout(() => openCap(), 300);
    </script>
  </body>
</html>
