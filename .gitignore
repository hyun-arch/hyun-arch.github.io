# build output
dist/
# dependencies
node_modules/
# astro
.astro/
# environment
.env
.env.production
# 🔴 secret (local-only) data — 재무·매출 등. 절대 커밋·배포 안 됨.
# (예시 템플릿과 README 만 커밋)
src/data/_secret/*
!src/data/_secret/README.md
!src/data/_secret/*.example.js
# os
.DS_Store

# QA 스크린샷 산출물
qa-shots/
qa-os/
qa-dna/
qa-deck/

# 발행 도구
publish/.env          # 토큰만 제외. 절대 커밋 금지
publish/sent/drafts/  # 네이버 초안(개인 글)
.gh-pages-work/
# publish/queue/ 와 publish/sent/log.jsonl 은 일부러 커밋한다 —
# 깃허브 액션이 큐를 읽어 발행하고 기록을 되돌려 놓는다(맥이 꺼져 있어도 돌게).

# 네이버 브라우저 프로필(로그인 상태) — 절대 커밋 금지
publish/.browser/
